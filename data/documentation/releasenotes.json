{"topicSections":[{"abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Career history — what shipped, when, and with what impact."}]}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Experience"],"title":"Changelog","anchor":"Changelog"},{"abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"The tools and technologies I work with."}]}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Skills"],"title":"Dependencies","anchor":"Dependencies"},{"abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Education and formal training."}]}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"],"title":"Build History","anchor":"Build-History"},{"abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Write-ups on the tools I build with."}]}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline"],"title":"Patch Notes","anchor":"Patch-Notes"},{"generated":true,"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/ReleaseNotes"],"title":"Enumerations","anchor":"Enumerations"}],"abstract":[{"type":"text","text":"Senior iOS Engineer with 12+ years of experience shipping apps that people actually use —"},{"type":"text","text":" "},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}],"variants":[{"paths":["\/documentation\/releasenotes"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Welcome to","color":{"standardColorIdentifier":"blue"},"modules":[{"name":"Haydar Karkin"}],"role":"collection","title":"Haydar Karkin","externalID":"ReleaseNotes","symbolKind":"module"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"},"sections":[],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"I’ve spent over a decade at the intersection of clean architecture and product delivery,"},{"type":"text","text":" "},{"type":"text","text":"working across Turkey, and now Germany. I’ve contributed to apps with millions of active"},{"type":"text","text":" "},{"type":"text","text":"users — including "},{"type":"strong","inlineContent":[{"type":"text","text":"BIP"}]},{"type":"text","text":" (3.5M monthly actives), "},{"type":"strong","inlineContent":[{"type":"text","text":"Finansbank"}]},{"type":"text","text":" (2M+ users), and"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"ioki"}]},{"type":"text","text":"’s white-label transit platform powering 70+ branded applications across Europe."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"My engineering philosophy is simple: code should be easy to delete, easy to test,"},{"type":"text","text":" "},{"type":"text","text":"and hard to misuse. I care deeply about the boundaries between layers, the contracts"},{"type":"text","text":" "},{"type":"text","text":"between modules, and the kind of pull request that teaches rather than just passes review."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond writing Swift, I’ve led teams, introduced testing cultures from scratch, built"},{"type":"text","text":" "},{"type":"text","text":"CI\/CD pipelines, and pushed for practices that make codebases healthier over time —"},{"type":"text","text":" "},{"type":"text","text":"not just on the day they’re written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This site is my development hub: a living CV, a place to think out loud about iOS"},{"type":"text","text":" "},{"type":"text","text":"development, and a record of what I’ve built and learned along the way."}]},{"type":"heading","level":3,"text":"Currently","anchor":"Currently"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"🚀 Senior iOS Developer at ","type":"text"},{"inlineContent":[{"type":"text","text":"ioki"}],"type":"strong"},{"text":", Frankfurt — building the future of demand-responsive transit","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"🌱 Deepening my knowledge of Swift 6 concurrency, strict concurrency checking, and actor isolation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"✍️ Writing about iOS architecture, testing, and the tools I reach for","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"Let’s connect","anchor":"Lets-connect"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"💼 ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.linkedin.com\/in\/haydar-karkin\/"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"🐙 ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://ReleaseNotes/documentation/ReleaseNotes/Education":{"type":"topic","abstract":[{"type":"text","text":"Formal education and the foundation it laid."}],"url":"\/documentation\/releasenotes\/education","role":"article","title":"Build History","kind":"article","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"},"doc://ReleaseNotes/documentation/ReleaseNotes/ReleaseNotes":{"type":"topic","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"ReleaseNotes"}],"url":"\/documentation\/releasenotes\/releasenotes","role":"symbol","title":"ReleaseNotes","kind":"symbol","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/ReleaseNotes","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReleaseNotes"}]},"doc://ReleaseNotes/documentation/ReleaseNotes/DoccPipeline":{"type":"topic","abstract":[{"type":"text","text":"Building one