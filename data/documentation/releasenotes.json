{"metadata":{"title":"Haydar Karkin","role":"collection","color":{"standardColorIdentifier":"blue"},"roleHeading":"Welcome to","symbolKind":"module","modules":[{"name":"Haydar Karkin"}],"externalID":"ReleaseNotes"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Changelog","title":"Changelog","abstract":[{"inlineContent":[{"text":"Career history — what shipped, when, and with what impact.","type":"text"}],"type":"emphasis"}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Experience"]},{"anchor":"Dependencies","title":"Dependencies","abstract":[{"type":"emphasis","inlineContent":[{"text":"The tools and technologies I work with.","type":"text"}]}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Skills"]},{"anchor":"Build-History","title":"Build History","abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Education and formal training."}]}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"]},{"anchor":"Patch-Notes","title":"Patch Notes","abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Write-ups on the tools I build with."}]}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator"]},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/ReleaseNotes"],"generated":true}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"I’ve spent over a decade at the intersection of clean architecture and product delivery,","type":"text"},{"text":" ","type":"text"},{"text":"working across Turkey, and now Germany. I’ve contributed to apps with millions of active","type":"text"},{"text":" ","type":"text"},{"text":"users — including ","type":"text"},{"inlineContent":[{"type":"text","text":"BIP"}],"type":"strong"},{"text":" (3.5M monthly actives), ","type":"text"},{"inlineContent":[{"type":"text","text":"Finansbank"}],"type":"strong"},{"text":" (2M+ users), and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"ioki","type":"text"}],"type":"strong"},{"text":"’s white-label transit platform powering 70+ branded applications across Europe.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"My engineering philosophy is simple: code should be easy to delete, easy to test,"},{"type":"text","text":" "},{"type":"text","text":"and hard to misuse. I care deeply about the boundaries between layers, the contracts"},{"type":"text","text":" "},{"type":"text","text":"between modules, and the kind of pull request that teaches rather than just passes review."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond writing Swift, I’ve led teams, introduced testing cultures from scratch, built"},{"type":"text","text":" "},{"type":"text","text":"CI\/CD pipelines, and pushed for practices that make codebases healthier over time —"},{"type":"text","text":" "},{"type":"text","text":"not just on the day they’re written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This site is my development hub: a living CV, a place to think out loud about iOS"},{"type":"text","text":" "},{"type":"text","text":"development, and a record of what I’ve built and learned along the way."}]},{"anchor":"Currently","level":3,"type":"heading","text":"Currently"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"🚀 Senior iOS Developer at ","type":"text"},{"inlineContent":[{"text":"ioki","type":"text"}],"type":"strong"},{"type":"text","text":", Frankfurt — building the future of demand-responsive transit"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"🌱 Deepening my knowledge of Swift 6 concurrency, strict concurrency checking, and actor isolation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"✍️ Writing about iOS architecture, testing, and the tools I reach for"}]}]}]},{"level":3,"text":"Let’s connect","anchor":"Lets-connect","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"💼 "},{"identifier":"https:\/\/www.linkedin.com\/in\/haydar-karkin\/","type":"reference","isActive":true}]}]},{"content":[{"inlineContent":[{"text":"🐙 ","type":"text"},{"identifier":"https:\/\/github.com\/haydarKarkin","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"},"abstract":[{"text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —","type":"text"},{"text":" ","type":"text"},{"text":"from real-time messaging platforms to fintech, transit, and enterprise tooling.","type":"text"}],"variants":[{"paths":["\/documentation\/releasenotes"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://github.com/haydarKarkin":{"identifier":"https:\/\/github.com\/haydarKarkin","titleInlineContent":[{"type":"text","text":"github.com\/haydarKarkin"}],"url":"https:\/\/github.com\/haydarKarkin","type":"link","title":"github.com\/haydarKarkin"},"doc://ReleaseNotes/documentation/ReleaseNotes":{"url":"\/documentation\/releasenotes","role":"collection","type":"topic","title":"Haydar Karkin","kind":"symbol","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","abstract":[{"type":"text","text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —"},{"text":" ","type":"text"},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}]},"doc://ReleaseNotes/documentation/ReleaseNotes/Skills":{"identifier":"doc:\/\/ReleaseNotes\/documentation\/R