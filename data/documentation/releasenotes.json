{"sections":[],"abstract":[{"type":"text","text":"Senior iOS Developer. I build iOS apps that keep working as they grow."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/releasenotes"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"},"topicSections":[{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Experience"],"anchor":"Changelog","abstract":[{"type":"text","text":"Work history: what shipped, where and when."}],"title":"Changelog"},{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Skills"],"anchor":"Dependencies","abstract":[{"type":"text","text":"The languages, frameworks and tools I work with."}],"title":"Dependencies"},{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"],"anchor":"Build-History","abstract":[{"type":"text","text":"Education."}],"title":"Build History"},{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator"],"anchor":"Patch-Notes","abstract":[{"type":"text","text":"Articles about the tools I build with."}],"title":"Patch Notes"},{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/ReleaseNotes"],"anchor":"Enumerations","title":"Enumerations","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"I’ve been building iOS apps for over a decade, first in Turkey and now in"},{"type":"text","text":" "},{"type":"text","text":"Germany. The work I care about most is the part users never see: clean"},{"type":"text","text":" "},{"type":"text","text":"architecture, tests you can trust, and release tooling that lets a small team"},{"type":"text","text":" "},{"type":"text","text":"ship often. It’s unglamorous. It’s also what makes release day boring, which"},{"type":"text","text":" "},{"type":"text","text":"is the goal."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Right now that means 70+ public transport apps on one Swift codebase at"},{"type":"text","text":" "},{"inlineContent":[{"text":"ioki","type":"text"}],"type":"strong"},{"type":"text","text":", part of a mobility platform that has served nearly 10 million"},{"type":"text","text":" "},{"type":"text","text":"passengers. Before that I worked on messaging ("},{"inlineContent":[{"text":"BiP","type":"text"}],"type":"strong"},{"type":"text","text":", 3.5M monthly users),"},{"type":"text","text":" "},{"type":"text","text":"banking ("},{"inlineContent":[{"text":"QNB Finansbank","type":"text"}],"type":"strong"},{"type":"text","text":"), live events at "},{"inlineContent":[{"text":"Cisco","type":"text"}],"type":"strong"},{"type":"text","text":", where we shipped 100+"},{"type":"text","text":" "},{"type":"text","text":"branded apps from one codebase, and public transport at "},{"inlineContent":[{"text":"Kentkart","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When I led a team at Ecospend, I did the groundwork for each new feature"},{"type":"text","text":" "},{"type":"text","text":"myself: the interfaces, the services and the test cases it had to pass. Then"},{"type":"text","text":" "},{"type":"text","text":"someone on the team built the rest."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This site is where I keep my CV and write about the tools I use. The pages are"},{"type":"text","text":" "},{"type":"text","text":"named like a release: the changelog is my work history, the dependencies are my"},{"type":"text","text":" "},{"type":"text","text":"stack, and the patch notes are articles."}],"type":"paragraph"},{"anchor":"Currently","type":"heading","level":3,"text":"Currently"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Senior iOS Developer at "},{"type":"strong","inlineContent":[{"text":"ioki","type":"text"}]},{"type":"text","text":" in Frankfurt, working on ticketing,"},{"type":"text","text":" "},{"type":"text","text":"real-time ride tracking and release tooling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Writing about iOS tooling. The latest pieces cover a DocC documentation"},{"type":"text","text":" "},{"type":"text","text":"pipeline and writing your own "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" operator."}]}]}],"type":"unorderedList"},{"anchor":"Get-in-touch","type":"heading","level":3,"text":"Get in touch"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/www.linkedin.com\/in\/haydar-karkin\/"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/haydarKarkin"}]}]}],"type":"unorderedList"}]}],"metadata":{"externalID":"ReleaseNotes","role":"collection","symbolKind":"module","roleHeading":"Welcome to","color":{"standardColorIdentifier":"blue"},"title":"Haydar Karkin","modules":[{"name":"Haydar Karkin"}]},"topicSectionsStyle":"compactGrid","references":{"doc://ReleaseNotes/documentation/ReleaseNotes/Experience":{"type":"topic","title":"Changelog","role":"article","images":[{"type":"card","identifier":"card-changelog.svg"}],"kind":"article","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Experience","abstract":[{"type":"text","text":"What I’ve shipped, company by company, newest first."}],"url":"\/documentation\/releasenotes\/experience"},"doc://ReleaseNotes/documentation/ReleaseNotes/Education":{"images":[{"type":"card","identifier":"card-education.svg"}],"url":"\/documentation\/releasenotes\/education","type":"topic","kind":"article","role":"article","identifier":"doc:\/\/ReleaseNotes\/do