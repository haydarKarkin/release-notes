{"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"collection","title":"Haydar Karkin","symbolKind":"module","color":{"standardColorIdentifier":"blue"},"roleHeading":"Welcome to","externalID":"ReleaseNotes","modules":[{"name":"Haydar Karkin"}]},"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/releasenotes"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —","type":"text"},{"text":" ","type":"text"},{"text":"from real-time messaging platforms to fintech, transit, and enterprise tooling.","type":"text"}],"topicSections":[{"anchor":"Changelog","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Experience"],"title":"Changelog","abstract":[{"inlineContent":[{"text":"Career history — what shipped, when, and with what impact.","type":"text"}],"type":"emphasis"}]},{"anchor":"Dependencies","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Skills"],"title":"Dependencies","abstract":[{"inlineContent":[{"text":"The tools and technologies I work with.","type":"text"}],"type":"emphasis"}]},{"anchor":"Build-History","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"],"title":"Build History","abstract":[{"inlineContent":[{"text":"Education and formal training.","type":"text"}],"type":"emphasis"}]},{"anchor":"Patch-Notes","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline"],"title":"Patch Notes","abstract":[{"inlineContent":[{"text":"Write-ups on the tools I build with.","type":"text"}],"type":"emphasis"}]},{"anchor":"Articles","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator"],"title":"Articles","generated":true},{"anchor":"Enumerations","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/ReleaseNotes"],"title":"Enumerations","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"I’ve spent over a decade at the intersection of clean architecture and product delivery,","type":"text"},{"text":" ","type":"text"},{"text":"working across Turkey, and now Germany. I’ve contributed to apps with millions of active","type":"text"},{"text":" ","type":"text"},{"text":"users — including ","type":"text"},{"type":"strong","inlineContent":[{"text":"BIP","type":"text"}]},{"text":" (3.5M monthly actives), ","type":"text"},{"type":"strong","inlineContent":[{"text":"Finansbank","type":"text"}]},{"text":" (2M+ users), and","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"ioki","type":"text"}]},{"text":"’s white-label transit platform powering 70+ branded applications across Europe.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"My engineering philosophy is simple: code should be easy to delete, easy to test,","type":"text"},{"text":" ","type":"text"},{"text":"and hard to misuse. I care deeply about the boundaries between layers, the contracts","type":"text"},{"text":" ","type":"text"},{"text":"between modules, and the kind of pull request that teaches rather than just passes review.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Beyond writing Swift, I’ve led teams, introduced testing cultures from scratch, built","type":"text"},{"text":" ","type":"text"},{"text":"CI\/CD pipelines, and pushed for practices that make codebases healthier over time —","type":"text"},{"text":" ","type":"text"},{"text":"not just on the day they’re written.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This site is my development hub: a living CV, a place to think out loud about iOS","type":"text"},{"text":" ","type":"text"},{"text":"development, and a record of what I’ve built and learned along the way.","type":"text"}],"type":"paragraph"},{"text":"Currently","anchor":"Currently","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"🚀 Senior iOS Developer at ","type":"text"},{"inlineContent":[{"type":"text","text":"ioki"}],"type":"strong"},{"text":", Frankfurt — building the future of demand-responsive transit","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"🌱 Deepening my knowledge of Swift 6 concurrency, strict concurrency checking, and actor isolation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"✍️ Writing about iOS architecture, testing, and the tools I reach for","type":"text"}]}]}],"type":"unorderedList"},{"text":"Let’s connect","anchor":"Lets-connect","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"💼 ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.linkedin.com\/in\/haydar-karkin\/","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"🐙 ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/haydarKarkin","type":"reference"}]}]}],"type":"unorderedList"}]}],"references":{"doc://ReleaseNotes/documentation/ReleaseNotes/Experience":{"url":"\/documentation\/releasenotes\/experience","title":"Changelog","role":"article","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Experience","type":"topic","kind":"article","abstract":[{"text":"A record of what I’ve shipped, improved, and broken (then fixed) across my career.","type":"text"}]},"doc://ReleaseNotes/documentation/ReleaseNotes/DoccPipeline":{"url":"\/documentation\/releasenotes\/doccpipeline","title":"Combining Generated and Manual Docs","role":"article","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","type":"topic","kind":"article","abstract":[{"text":"Building one documentation site from two sources: the API reference the","type":"text"}