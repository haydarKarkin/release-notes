{"variants":[{"paths":["\/documentation\/releasenotes"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Welcome to","color":{"standardColorIdentifier":"blue"},"externalID":"ReleaseNotes","modules":[{"name":"Haydar Karkin"}],"role":"collection","symbolKind":"module","title":"Haydar Karkin"},"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"},"abstract":[{"type":"text","text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —"},{"type":"text","text":" "},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"topicSections":[{"abstract":[{"inlineContent":[{"type":"text","text":"Career history — what shipped, when, and with what impact."}],"type":"emphasis"}],"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Experience"],"anchor":"Changelog","title":"Changelog"},{"abstract":[{"inlineContent":[{"text":"The tools and technologies I work with.","type":"text"}],"type":"emphasis"}],"title":"Dependencies","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Skills"],"anchor":"Dependencies"},{"abstract":[{"inlineContent":[{"type":"text","text":"Education and formal training."}],"type":"emphasis"}],"title":"Build History","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"],"anchor":"Build-History"},{"abstract":[{"type":"emphasis","inlineContent":[{"text":"Write-ups on the tools I build with.","type":"text"}]}],"title":"Patch Notes","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline"],"anchor":"Patch-Notes"},{"anchor":"Enumerations","generated":true,"title":"Enumerations","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/ReleaseNotes"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"I’ve spent over a decade at the intersection of clean architecture and product delivery,"},{"type":"text","text":" "},{"type":"text","text":"working across Turkey, and now Germany. I’ve contributed to apps with millions of active"},{"type":"text","text":" "},{"type":"text","text":"users — including "},{"inlineContent":[{"text":"BIP","type":"text"}],"type":"strong"},{"type":"text","text":" (3.5M monthly actives), "},{"inlineContent":[{"text":"Finansbank","type":"text"}],"type":"strong"},{"text":" (2M+ users), and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"ioki"}],"type":"strong"},{"text":"’s white-label transit platform powering 70+ branded applications across Europe.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"My engineering philosophy is simple: code should be easy to delete, easy to test,","type":"text"},{"text":" ","type":"text"},{"text":"and hard to misuse. I care deeply about the boundaries between layers, the contracts","type":"text"},{"text":" ","type":"text"},{"text":"between modules, and the kind of pull request that teaches rather than just passes review.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Beyond writing Swift, I’ve led teams, introduced testing cultures from scratch, built","type":"text"},{"text":" ","type":"text"},{"text":"CI\/CD pipelines, and pushed for practices that make codebases healthier over time —","type":"text"},{"text":" ","type":"text"},{"text":"not just on the day they’re written.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This site is my development hub: a living CV, a place to think out loud about iOS"},{"type":"text","text":" "},{"type":"text","text":"development, and a record of what I’ve built and learned along the way."}]},{"anchor":"Currently","type":"heading","level":3,"text":"Currently"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"🚀 Senior iOS Developer at "},{"type":"strong","inlineContent":[{"text":"ioki","type":"text"}]},{"type":"text","text":", Frankfurt — building the future of demand-responsive transit"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"🌱 Deepening my knowledge of Swift 6 concurrency, strict concurrency checking, and actor isolation"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"✍️ Writing about iOS architecture, testing, and the tools I reach for"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Let’s connect","anchor":"Lets-connect","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"💼 ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.linkedin.com\/in\/haydar-karkin\/"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"🐙 "},{"identifier":"https:\/\/github.com\/haydarKarkin","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"https://www.linkedin.com/in/haydar-karkin/":{"url":"https:\/\/www.linkedin.com\/in\/haydar-karkin\/","titleInlineContent":[{"type":"text","text":"linkedin.com\/in\/haydar-karkin"}],"identifier":"https:\/\/www.linkedin.com\/in\/haydar-karkin\/","title":"linkedin.com\/in\/haydar-karkin","type":"link"},"doc://ReleaseNotes/documentation/ReleaseNotes/Skills":{"type":"topic","url":"\/documentation\/releasenotes\/skills","abstract":[{"type":"text","text":"The tools, languages, and frameworks I reach for — and why."}],"identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Skills","kind":"article","role":"article","title":"Dependencies"},"doc://ReleaseNotes/documentation/ReleaseNotes":{"type":"topic","url":"\/documentation\/releasenotes","abstract":[{"type":"text","text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —"},{"type":"text","text":" "},{"type":"text","te