":" — complex entity graphs, multi-context setups (Turkcell)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"SQL","type":"text"}],"type":"strong"},{"text":" — general relational DB knowledge","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"level":2,"text":"Signature Practices","anchor":"Signature-Practices","type":"heading"},{"inlineContent":[{"text":"Beyond tools — the ways of working I bring to every team:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Functional & Reactive Programming","type":"text"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Dependency Injection","type":"text"}],"type":"strong"},{"text":" — constructor injection preferred, DI containers when needed","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Design Patterns","type":"text"}],"type":"strong"},{"text":" — practical application, not pattern-for-pattern’s-sake","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Code Review culture","type":"text"}],"type":"strong"},{"text":" — I give reviews that teach, not just approve or reject","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Application Profiling","type":"text"}],"type":"strong"},{"text":" — Instruments is a first-class debugging tool for me","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Agile \/ Scrum","type":"text"}],"type":"strong"},{"text":" — ran sprints as team lead, participated meaningfully as IC","type":"text"}],"type":"paragraph"}]}]}]}],"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Skills","interfaceLanguage":"swift"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/releasenote