{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Over 12 years I’ve built up a stack that I’m genuinely comfortable with,","type":"text"},{"text":" ","type":"text"},{"text":"not just familiar with. Here’s what I use and what I think of each.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Core-Languages","level":2,"text":"Core Languages"},{"anchor":"Swift","text":"Swift","type":"heading","level":3},{"inlineContent":[{"text":"My primary language. I’ve been writing Swift since the early days and have","type":"text"},{"type":"text","text":" "},{"type":"text","text":"watched it mature into one of the best-designed languages in the industry."},{"type":"text","text":" "},{"type":"text","text":"Strong opinions on value types, protocol-oriented design, and the right"},{"type":"text","text":" "},{"type":"text","text":"use of generics."}],"type":"paragraph"},{"level":3,"text":"Objective-C","anchor":"Objective-C","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Still fluent. Legacy codebases don’t scare me — bridging Swift and ObjC"},{"type":"text","text":" "},{"text":"in mixed projects is something I’ve done extensively.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"iOS-Frameworks","text":"iOS Frameworks"},{"rows":[[[{"inlineContent":[{"text":"Framework","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Depth","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"UIKit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expert — built complex custom UI, animations, layout systems"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Production experience, follow evolution closely"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Core Data","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Extensive — entity design, migration strategies, sync","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Combine","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Production use for reactive state management","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Instruments"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Deep profiling, memory leak detection, time profiling","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"thematicBreak"},{"type":"heading","anchor":"Reactive-Programming","level":2,"text":"Reactive Programming"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"RxSwift","type":"text"}],"type":"strong"},{"text":" — primary reactive framework across multiple projects","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Combine","type":"text"}],"type":"strong"},{"text":" — preferred for new Swift-first codebases","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"ReactiveObjC","type":"text"}],"type":"strong"},{"text":" — legacy projects at Turkcell\/Ericsson","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"level":2,"text":"Networking","anchor":"Networking","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"REST APIs","type":"text"}],"type":"strong"},{"type":"text","text":" — standard, done this hundreds of times"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"GraphQL","type":"text"}],"type":"strong"},{"text":" — used at Ecospend","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"XMPP"}],"type":"strong"},{"text":" — real-time messaging protocol at Turkcell (BIP)","type":"text"}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"type":"heading","anchor":"Architecture","level":2,"text":"Architecture"},{"type":"paragraph","inlineContent":[{"text":"I’ve worked in and led migrations between multiple patterns:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"MVVM-C","type":"text"}],"type":"strong"},{"text":" — preferred for larger codebases; coordinators keep navigation testable","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"MVVM","type":"text"}],"type":"strong"},{"text":" — solid default for most projects","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"MVC","type":"text"}],"type":"strong"},{"text":" — understand its tradeoffs; can work with it, prefer to evolve away from it","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Deeper principles I apply regardless of pattern: "},{"type":"strong","inlineContent":[{"text":"SOLID","type":"text"}]},{"type":"text","text":", "},{"inlineContent":[{"text":"dependency injection","type":"text"}],"type":"strong"},{"text":",","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"protocol-oriented design","type":"text"}],"type":"strong"},{"text":", ","type":"text"},{"inlineContent":[{"text":"clean boundaries between layers","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Unit Testing"}],"type":"strong"},{"text":" — XCTest, protocol mocking, test-driven features","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Snapshot Testing","type":"text"}],"type":"strong"},{"text":" — iOSSnapshotTestCase; introduced at Cisco, cut defects 40%","type":"text"}],"type":"paragraph"}]},{"content":[{"in