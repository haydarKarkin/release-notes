{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Over 12 years I’ve built up a stack that I’m genuinely comfortable with,"},{"type":"text","text":" "},{"type":"text","text":"not just familiar with. Here’s what I use and what I think of each."}]},{"type":"thematicBreak"},{"level":2,"anchor":"Core-Languages","type":"heading","text":"Core Languages"},{"level":3,"anchor":"Swift","type":"heading","text":"Swift"},{"inlineContent":[{"type":"text","text":"My primary language. I’ve been writing Swift since the early days and have"},{"type":"text","text":" "},{"type":"text","text":"watched it mature into one of the best-designed languages in the industry."},{"text":" ","type":"text"},{"text":"Strong opinions on value types, protocol-oriented design, and the right","type":"text"},{"text":" ","type":"text"},{"text":"use of generics.","type":"text"}],"type":"paragraph"},{"anchor":"Objective-C","text":"Objective-C","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Still fluent. Legacy codebases don’t scare me — bridging Swift and ObjC"},{"text":" ","type":"text"},{"text":"in mixed projects is something I’ve done extensively.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","text":"iOS Frameworks","level":2,"anchor":"iOS-Frameworks"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Framework","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Depth"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"UIKit"}]}],[{"inlineContent":[{"text":"Expert — built complex custom UI, animations, layout systems","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"SwiftUI","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Production experience, follow evolution closely"}]}]],[[{"inlineContent":[{"type":"text","text":"Core Data"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Extensive — entity design, migration strategies, sync","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Combine"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Production use for reactive state management","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Instruments","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Deep profiling, memory leak detection, time profiling"}],"type":"paragraph"}]]],"header":"row"},{"type":"thematicBreak"},{"type":"heading","text":"Reactive Programming","level":2,"anchor":"Reactive-Programming"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"RxSwift"}],"type":"strong"},{"type":"text","text":" — primary reactive framework across multiple projects"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Combine"}],"type":"strong"},{"type":"text","text":" — preferred for new Swift-first codebases"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ReactiveObjC"}],"type":"strong"},{"text":" — legacy projects at Turkcell\/Ericsson","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"type":"heading","text":"Networking","level":2,"anchor":"Networking"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"REST APIs","type":"text"}]},{"text":" — standard, done this hundreds of times","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"GraphQL"}],"type":"strong"},{"text":" — used at Ecospend","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"XMPP"}]},{"type":"text","text":" — real-time messagin