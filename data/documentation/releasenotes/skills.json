ing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"REST APIs"}],"type":"strong"},{"text":" — standard, done this hundreds of times","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"GraphQL"}],"type":"strong"},{"text":" — used at Ecospend","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"XMPP"}],"type":"strong"},{"text":" — real-time messaging protocol at Turkcell (BIP)","type":"text"}]}]}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Architecture","level":2,"text":"Architecture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"I’ve worked in and led migrations between multiple patterns:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"MVVM-C"}],"type":"strong"},{"text":" — preferred for larger codebases; coordinators keep navigation testable","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"MVVM"}],"type":"strong"},{"text":" — solid default for most projects","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"MVC"}],"type":"strong"},{"text":" — understand its tradeoffs; can work with it, prefer to evolve away from it","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deeper principles I apply regardless of pattern: "},{"type":"strong","inlineContent":[{"type":"text","text":"SOLID"}]},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"dependency injection"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"protocol-oriented design"}]},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"clean boundaries between layers"}]},{"type":"text","text":"."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Testing","level":2,"text":"Testing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Unit Testing"}],"type":"strong"},{"text":" — XCTest, protocol mocking, test-driven features","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Snapshot Testing"}],"type":"strong"},{"text":" — iOSSnapshotTestCase; introduced at Cisco, cut defects 40%","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"BDD"}],"type":"strong"},{"text":" — Behavior-Driven Development with Quick\/Nimble","type":"text"}]}]}]},{"type":"thematicBreak"},{"type":"heading","anchor":"CICD--Tooling","level":2,"text":"CI\/CD & Tooling"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tool"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fastlane"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automated builds, signing, App Store deploys"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bitrise"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary CI platform at Cisco and Ecospend"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"GitHub Actions"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used for open-source and personal projects"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"SonarQube"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Static analysis, code quality gates"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Danger"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automated PR checks and linting"}]}]],[[{"type":