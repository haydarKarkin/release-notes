{"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"ReleaseNotes"}],"title":"Build History"},"variants":[{"paths":["\/documentation\/releasenotes\/education"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"},"abstract":[{"type":"text","text":"Formal education and the foundation it laid."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"I studied Computer Engineering in English at two Turkish universities, graduating","type":"text"},{"text":" ","type":"text"},{"text":"with strong GPAs in both. My master’s coursework deepened my theoretical foundations","type":"text"},{"text":" ","type":"text"},{"text":"while my career was already in full swing — an intentional overlap that made","type":"text"},{"text":" ","type":"text"},{"text":"both more meaningful.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Attended Master’s Degree","anchor":"Attended-Masters-Degree","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Computer Engineering (English)"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir Institute of Technology · 2018 · GPA 3.14 \/ 4.0"}],"type":"paragraph"},{"inlineContent":[{"text":"Advanced coursework in algorithms, distributed systems, and software engineering theory.","type":"text"},{"text":" ","type":"text"},{"text":"Studied while already working professionally — every concept mapped directly onto","type":"text"},{"text":" ","type":"text"},{"text":"real problems I was solving.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Bachelor’s Degree","anchor":"Bachelors-Degree","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Computer Engineering (English)"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir University · 2013 · GPA 3.11 \/ 4.0"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Four-year foundation in computer science: data structures, operating systems,"},{"type":"text","text":" "},{"type":"text","text":"databases, software architecture, and mathematics. Graduated and entered"},{"type":"text","text":" "},{"type":"text","text":"the industry as a Software Test Engineer at Cybersoft — quality first,"},{"type":"text","text":" "},{"type":"text","text":"from day one."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"url":"\/documentation\/releasenotes","role":"collection","abstract":[],"title":"ReleaseNotes","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","type":"topic","kind":"symbol"}}}