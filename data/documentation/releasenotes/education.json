{"abstract":[{"type":"text","text":"Formal education and the foundation it laid."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/releasenotes\/education"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"Build History","role":"article","modules":[{"name":"Haydar Karkin"}],"roleHeading":"Article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"},"sections":[],"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"I studied Computer Engineering in English at two Turkish universities, graduating"},{"type":"text","text":" "},{"type":"text","text":"with strong GPAs in both. My master’s coursework deepened my theoretical foundations"},{"type":"text","text":" "},{"type":"text","text":"while my career was already in full swing — an intentional overlap that made"},{"type":"text","text":" "},{"type":"text","text":"both more meaningful."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Attended-Masters-Degree","level":2,"text":"Attended Master’s Degree"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Computer Engineering (English)"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir Institute of Technology · 2018 · GPA 3.14 \/ 4.0"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced coursework in algorithms, distributed systems, and software engineering theory."},{"type":"text","text":" "},{"type":"text","text":"Studied while already working professionally — every concept mapped directly onto"},{"type":"text","text":" "},{"type":"text","text":"real problems I was solving."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Bachelors-Degree","level":2,"text":"Bachelor’s Degree"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Computer Engineering (English)"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir University · 2013 · GPA 3.11 \/ 4.0"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Four-year foundation in computer science: data structures, operating systems,"},{"type":"text","text":" "},{"type":"text","text":"databases, software architecture, and mathematics. Graduated and entered"},{"type":"text","text":" "},{"type":"text","text":"the industry as a Software Test Engineer at Cybersoft — quality first,"},{"type":"text","text":" "},{"type":"text","text":"from day one."}]}]}],"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"type":"topic","abstract":[{"type":"text","text":"Senior iOS Engineer with 12+ years of experience shipping apps that people actually use —"},{"type":"text","text":" "},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}],"url":"\/documentation\/releasenotes","role":"collection","title":"Haydar Karkin","kind":"symbol","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"}}}