{"variants":[{"paths":["\/documentation\/releasenotes\/education"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Formal education and the foundation it laid."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"I studied Computer Engineering in English at two Turkish universities, graduating","type":"text"},{"text":" ","type":"text"},{"text":"with strong GPAs in both. My master’s coursework deepened my theoretical foundations","type":"text"},{"text":" ","type":"text"},{"text":"while my career was already in full swing — an intentional overlap that made","type":"text"},{"text":" ","type":"text"},{"text":"both more meaningful.","type":"text"}]},{"type":"thematicBreak"},{"text":"Attended Master’s Degree","type":"heading","level":2,"anchor":"Attended-Masters-Degree"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Computer Engineering (English)","type":"text"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir Institute of Technology · 2018 · GPA 3.14 \/ 4.0"}]},{"type":"paragraph","inlineContent":[{"text":"Advanced coursework in algorithms, distributed systems, and software engineering theory.","type":"text"},{"text":" ","type":"text"},{"text":"Studied while already working professionally — every concept mapped directly onto","type":"text"},{"text":" ","type":"text"},{"text":"real problems I was solving.","type":"text"}]},{"type":"thematicBreak"},{"text":"Bachelor’s Degree","type":"heading","level":2,"anchor":"Bachelors-Degree"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Computer Engineering (English)","type":"text"}],"type":"strong"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"text":"Izmir University · 2013 · GPA 3.11 \/ 4.0","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Four-year foundation in computer science: data structures, operating systems,","type":"text"},{"text":" ","type":"text"},{"text":"databases, software architecture, and mathematics. Graduated and entered","type":"text"},{"text":" ","type":"text"},{"text":"the industry as a Software Test Engineer at Cybersoft — quality first,","type":"text"},{"text":" ","type":"text"},{"text":"from day one.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education"},"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Build History","role":"article","modules":[{"name":"ReleaseNotes"}],"roleHeading":"Article"},"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","role":"collection","url":"\/documentation\/releasenotes","kind":"symbol","type":"topic","title":"ReleaseNotes","abstract":[]}}}