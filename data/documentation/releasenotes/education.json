{"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"variants":[{"paths":["\/documentation\/releasenotes\/education"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Formal education and the foundation it laid."}],"kind":"article","sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"I studied Computer Engineering in English at two Turkish universities, graduating","type":"text"},{"text":" ","type":"text"},{"text":"with strong GPAs in both. My master’s coursework deepened my theoretical foundations","type":"text"},{"text":" ","type":"text"},{"text":"while my career was already in full swing — an intentional overlap that made","type":"text"},{"text":" ","type":"text"},{"text":"both more meaningful.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"Attended Master’s Degree","anchor":"Attended-Masters-Degree"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Computer Engineering (English)"}],"type":"strong"},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir Institute of Technology · 2018 · GPA 3.14 \/ 4.0"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced coursework in algorithms, distributed systems, and software engineering theory."},{"type":"text","text":" "},{"type":"text","text":"Studied while already working professionally — every concept mapped directly onto"},{"type":"text","text":" "},{"type":"text","text":"real problems I was solving."}]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"Bachelor’s Degree","anchor":"Bachelors-Degree"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Computer Engineering (English)"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir University · 2013 · GPA 3.11 \/ 4.0"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Four-year foundation in computer science: data structures, operating systems,"},{"type":"text","text":" "},{"type":"text","text":"databases, software architecture, and mathematics. Graduated and entered"},{"type":"text","text":" "},{"type":"text","text":"the industry as a Software Test Engineer at Cybersoft — quality first,"},{"type":"text","text":" "},{"type":"text","text":"from day one."}]}],"kind":"content"}],"metadata":{"role":"article","modules":[{"name":"ReleaseNotes"}],"roleHeading":"Article","title":"Build History"},"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education","interfaceLanguage":"swift"},"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"type":"topic","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","abstract":[],"role":"collection","url":"\/documentation\/releasenotes","kind":"symbol","title":"ReleaseNotes"}}}