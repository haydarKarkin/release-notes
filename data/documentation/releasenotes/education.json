{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/releasenotes\/education"]}],"abstract":[{"type":"text","text":"Formal education and the foundation it laid."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Build History","modules":[{"name":"Haydar Karkin"}]},"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"I studied Computer Engineering in English at two Turkish universities, graduating"},{"type":"text","text":" "},{"type":"text","text":"with strong GPAs in both. My master’s coursework deepened my theoretical foundations"},{"type":"text","text":" "},{"type":"text","text":"while my career was already in full swing — an intentional overlap that made"},{"type":"text","text":" "},{"type":"text","text":"both more meaningful."}]},{"type":"thematicBreak"},{"type":"heading","text":"Attended Master’s Degree","anchor":"Attended-Masters-Degree","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Computer Engineering (English)","type":"text"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir Institute of Technology · 2018 · GPA 3.14 \/ 4.0"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced coursework in algorithms, distributed systems, and software engineering theory."},{"type":"text","text":" "},{"type":"text","text":"Studied while already working professionally — every concept mapped directly onto"},{"type":"text","text":" "},{"type":"text","text":"real problems I was solving."}]},{"type":"thematicBreak"},{"type":"heading","text":"Bachelor’s Degree","anchor":"Bachelors-Degree","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Computer Engineering (English)","type":"text"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"Izmir University · 2013 · GPA 3.11 \/ 4.0"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Four-year foundation in computer science: data structures, operating systems,"},{"type":"text","text":" "},{"type":"text","text":"databases, software architecture, and mathematics. Graduated and entered"},{"type":"text","text":" "},{"type":"text","text":"the industry as a Software Test Engineer at Cybersoft — quality first,"},{"type":"text","text":" "},{"type":"text","text":"from day one."}]}],"kind":"content"}],"kind":"article","references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"url":"\/documentation\/releasenotes","kind":"symbol","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","role":"collection","abstract":[{"type":"text","text":"Senior iOS Engineer with 12+ years of experience shipping apps that people actually use —"},{"text":" ","type":"text"},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}],"title":"Haydar Karkin","type":"topic"}}}