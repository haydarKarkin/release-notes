{"abstract":[{"text":"Formal education and the foundation it laid.","type":"text"}],"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/Education","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Haydar Karkin"}],"title":"Build History","role":"article"},"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"I studied Computer Engineering in English at two Turkish universities, graduating","type":"text"},{"text":" ","type":"text"},{"text":"with strong GPAs in both. My master’s coursework deepened my theoretical foundations","type":"text"},{"text":" ","type":"text"},{"text":"while my career was already in full swing — an intentional overlap that made","type":"text"},{"text":" ","type":"text"},{"text":"both more meaningful.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"text":"Attended Master’s Degree","type":"heading","anchor":"Attended-Masters-Degree"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Computer Engineering (English)"}],"type":"strong"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"text":"Izmir Institute of Technology · 2018 · GPA 3.14 \/ 4.0","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced coursework in algorithms, distributed systems, and software engineering theory."},{"type":"text","text":" "},{"type":"text","text":"Studied while already working professionally — every concept mapped directly onto"},{"type":"text","text":" "},{"type":"text","text":"real problems I was solving."}]},{"type":"thematicBreak"},{"level":2,"text":"Bachelor’s Degree","type":"heading","anchor":"Bachelors-Degree"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Computer Engineering (English)"}],"type":"strong"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"text":"Izmir University · 2013 · GPA 3.11 \/ 4.0","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Four-year foundation in computer science: data structures, operating systems,"},{"type":"text","text":" "},{"type":"text","text":"databases, software architecture, and mathematics. Graduated and entered"},{"type":"text","text":" "},{"type":"text","text":"the industry as a Software Test Engineer at Cybersoft — quality first,"},{"type":"text","text":" "},{"type":"text","text":"from day one."}]}]}],"variants":[{"paths":["\/documentation\/releasenotes\/education"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"abstract":[{"text":"Senior iOS Engineer with 12+ years of experience shipping apps that people actually use —","type":"text"},{"text":" ","type":"text"},{"text":"from real-time messaging platforms to fintech, transit, and enterprise tooling.","type":"text"}],"title":"Haydar Karkin","role":"collection","type":"topic","url":"\/documentation\/releasenotes","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","kind":"symbol"}}}