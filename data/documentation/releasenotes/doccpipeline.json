{"sections":[],"variants":[{"paths":["\/documentation\/releasenotes\/doccpipeline"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"sampleCodeDownload":{"action":{"identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit","overridingTitle":"View GardenKit on GitHub","type":"reference","isActive":true},"kind":"sampleDownload"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline"},"seeAlsoSections":[{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator"],"anchor":"Patch-Notes","title":"Patch Notes","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"This site uses the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-docc-plugin"},{"type":"text","text":". One command and it works,"},{"type":"text","text":" "},{"type":"text","text":"because this is a Swift package with a single target."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In bigger projects the setup is not that simple. An Xcode project with many"},{"type":"text","text":" "},{"type":"text","text":"targets, a framework whose docs live in a separate folder, a site that also"},{"type":"text","text":" "},{"type":"text","text":"carries onboarding pages. In those cases the plugin is not enough and you have"},{"type":"text","text":" "},{"type":"text","text":"to run "},{"code":"docc","type":"codeVoice"},{"type":"text","text":" yourself."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Here is how I do it. Every step is implemented in "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit"},{"type":"text","text":", a"},{"type":"text","text":" "},{"type":"text","text":"small package that only exists to be documented, so you can read the real"},{"type":"text","text":" "},{"type":"text","text":"files instead of my snippets."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"The-two-halves","type":"heading","level":2,"text":"The two halves"},{"inlineContent":[{"type":"text","text":"DocC can render two kinds of content."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Generated API reference.","type":"text"}],"type":"strong"},{"type":"text","text":" Types and functions with their doc comments. You"},{"type":"text","text":" "},{"type":"text","text":"never write these pages. The compiler describes your module in a "},{"inlineContent":[{"text":"symbol","type":"text"},{"text":" ","type":"text"},{"text":"graph","type":"text"}],"type":"emphasis"},{"type":"text","text":", one JSON file per module, and DocC turns it into pages."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Manual documentation.","type":"text"}],"type":"strong"},{"type":"text","text":" Articles and guides you write as Markdown inside a"},{"type":"text","text":" "},{"inlineContent":[{"text":"documentation catalog","type":"text"}],"type":"emphasis"},{"type":"text","text":", a folder ending in "},{"code":".docc","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Alone, neither is enough. The API reference says what a function returns, but"},{"type":"text","text":" "},{"type":"text","text":"not why the feature exists. The guide explains the idea, but cannot link into"},{"type":"text","text":" "},{"type":"text","text":"the code. Putting them together is one flag. The rest is the work around it."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"1-Write-the-doc-comments","type":"heading","level":2,"text":"1. Write the doc comments"},{"inlineContent":[{"type":"text","text":"Generated pages are only as good as the comments in the code. A one line"},{"type":"text","text":" "},{"type":"text","text":"summary, then details, then the parameters. Keep the summary to one sentence,"},{"type":"text","text":" "},{"type":"text","text":"because DocC reuses it as the subtitle in every list."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only "},{"code":"public","type":"codeVoice"},{"type":"text","text":" and "},{"code":"open","type":"codeVoice"},{"type":"text","text":" symbols end up in the symbol graph, so"},{"type":"text","text":" "},{"type":"text","text":"never show up on the website."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"2-Add-a-catalog","type":"heading","level":2,"text":"2. Add a catalog"},{"inlineContent":[{"type":"text","text":"The catalog can live anywhere. It does not have to be inside a target, because"},{"type":"text","text":" "},{"type":"text","text":"you pass its path to "},{"code":"docc","type":"codeVoice"},{"type":"text","text":" directly:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["doc\/","└── GardenKit.docc\/","    ├── GardenKit.md      # landing page","    └── Guides\/"]},{"inlineContent":[{"type":"text","text":"DocC flattens the catalog and finds pages by file name, so the folders are"},{"type":"text","text":" "},{"type":"text","text":"only for your own order. Keep the file names unique."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One page becomes the front door. If you title a file with the module name in"},{"type":"text","text":" "},{"type":"text","text":"double backticks, DocC merges it into the generated module page:"},{"type":"text","text":" "},{"type":"text","text":"becomes the overview and your "},{"code":"Topics","type":"codeVoice"},{"type":"text","text":" groups set the order of everything"},{"type":"text","text":" "},{"type":"text","text":"below. That is what GardenKit and this site do."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"3-Get-the-symbol-graphs","type":"heading","level":2,"text":"3. Get the symbol graphs"},{"inlineContent":[{"type":"text","text":"Now the generated half. Ask the compiler for symbol graphs while"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["xcodebuild build \\","    -scheme \"GardenKit\" \\","    -destination \"generic\/platform=iOS Simulator\" \\","    -derivedDataPath \"$build_dir\" \\","    -quiet \\","    OTHER_SWIFT_FLAGS=\"\\$(inherited) -emit-symbol-graph -emit-symbol-graph-dir $symbol_graphs_dir\""]},{"inlineContent":[{"type":"text","text":"Three details matter here."}],"type":"paragraph"},{"inlineContent":[{"code":"generic\/platform=iOS Simulator","type":"codeVoice"},{"type":"text","text":" builds for the simulator SDK without picking"},{"type":"text","text":" "},{"type":"text","text":"a device, so codesigning never runs. A docs job has nothing to s"}],"type":"paragraph"},{"inlineContent":[{"code":"\\$(inherited)","type":"codeVoice"},{"type":"text","text":" keeps the flags the project already sets. If you drop it, the"},{"type":"text","text":" "},{"type":"text","text":"module compiles differently and you will not notice right away."}],"type":"paragraph"},{"inlineContent":[{"code":"build","type":"codeVoice"},{"type":"text","text":", not "},{"code":"docbuild","type":"codeVoice"},{"type":"text","text":". "},{"code":"xcodebuild docbuild","type":"codeVoice"},{"type":"text","text":" looks easier, but"},{"type":"text","text":" "},{"type":"text","text":"documentation for the whole dependency tree. If one of those dependencies has"},{"type":"text","text":" "},{"type":"text","text":"Objective-C headers, DocC’s header pass can fail with duplicate symbol errors"},{"type":"text","text":" "},{"type":"text","text":"and the build stops. A plain "},{"code":"build","type":"codeVoice"},{"type":"text","text":" never runs that pass. It on"},{"type":"text","text":" "},{"type":"text","text":"the Swift symbol graphs, which is all DocC needs. This took me a while to"},{"type":"text","text":" "},{"type":"text","text":"figure out."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"4-Keep-only-your-module","type":"heading","level":2,"text":"4. Keep only your module"},{"inlineContent":[{"type":"text","text":"The build writes a graph for every module it compiled, including"},{"type":"text","text":" "},{"type":"text","text":"dependencies. If you pass all of them to DocC, your dependencies"},{"type":"text","text":" "},{"type":"text","text":"your website:"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["find \"$symbol_graphs_dir\" -type f -name '*.symbols.json' \\","    ! -name 'GardenKit.symbols.json' \\","    ! -name 'GardenKit@*.symbols.json' \\","    -delete"]},{"inlineContent":[{"type":"text","text":"Both patterns are needed. "},{"code":"GardenKit.symbols.json","type":"codeVoice"},{"type":"text","text":" has your own symbols."},{"type":"text","text":" "},{"code":"GardenKit@Foundation.symbols.json","type":"codeVoice"},{"type":"text","text":" is an extension graph, one per module you"},{"type":"text","text":" "},{"type":"text","text":"extend. Delete those and every "},{"code":"extension Date","type":"codeVoice"},{"type":"text","text":" in your code qui"},{"type":"text","text":" "},{"type":"text","text":"disappears from the site."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"5-Put-them-together","type":"heading","level":2,"text":"5. Put them together"},{"inlineContent":[{"type":"text","text":"This is the command everything was preparing for:"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["xcrun docc convert \"doc\/GardenKit.docc\" \\","    --additional-symbol-graph-dir \"$symbol_graphs_dir\" \\","    --fallback-display-name \"GardenKit\" \\","    --fallback-bundle-identifier \"com.example.gardenkit\" \\","    --output-dir \"$output_dir\" \\","    --transform-for-static-hosting \\","    --emit-digest"]},{"inlineContent":[{"code":"--additional-symbol-graph-dir","type":"codeVoice"},{"type":"text","text":" is the flag that merges the two"},{"type":"text","text":" "},{"type":"text","text":"symbol links in your articles resolve because of it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The two "},{"code":"--fallback-*","type":"codeVoice"},{"type":"text","text":" options give DocC the metadata Xcode would normally"},{"type":"text","text":" "},{"type":"text","text":"pass for a target. A catalog you convert by hand has no target, so they are"},{"type":"text","text":" "},{"type":"text","text":"required. "},{"code":"--transform-for-static-hosting","type":"codeVoice"},{"type":"text","text":" makes the output serv"},{"type":"text","text":" "},{"type":"text","text":"file host, and "},{"code":"--emit-digest","type":"codeVoice"},{"type":"text","text":" writes the index the search needs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While writing, use "},{"code":"preview","type":"codeVoice"},{"type":"text","text":" instead of "},{"code":"convert","type":"codeVoice"},{"type":"text","text":". Same options,"},{"type":"text","text":" "},{"code":"localhost:8080","type":"codeVoice"},{"type":"text","text":", and reloads when you save a Markdown file. It reads the"},{"type":"text","text":" "},{"type":"text","text":"symbol graphs from the folder you already created, so there is no rebuild."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"6-Serve-it","type":"heading","level":2,"text":"6. Serve it"},{"inlineContent":[{"type":"text","text":"If the site is not at the root of the domain, pass the prefix or"},{"type":"text","text":" "},{"type":"text","text":"URL will be wrong:"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["xcrun docc convert … --hosting-base-path \"docs\""]},{"inlineContent":[{"type":"text","text":"DocC does not write a root page either, so add a redirect:"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["echo '<script>window.location.href += \"documentation\/gardenkit\"<\/script>' \\","    > \"$output_dir\/index.html\""]},{"inlineContent":[{"type":"text","text":"That is the whole pipeline. I keep it in a script with a "},{"code":"-o","type":"codeVoice"},{"type":"text","text":" fl"},{"type":"text","text":" "},{"type":"text","text":"the docs are previewed locally, with it they are converted for hosting. The"},{"type":"text","text":" "},{"type":"text","text":"full version is "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh"},{"type":"text","text":". In CI the output is just a folder of"},{"type":"text","text":" "},{"type":"text","text":"static files, so publishing it is a copy."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"Common-problems","type":"heading","level":2,"text":"Common problems"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"Topic reference 'Plant' couldn't be resolved."}],"type":"strong"},{"text":" The symbol graphs did","type":"text"},{"text":" ","type":"text"},{"text":"not reach DocC. Check the path you passed, and that pruning did not delete","type":"text"},{"text":" ","type":"text"},{"text":"your own graph.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Extensions are missing."}],"type":"strong"},{"text":" The ","type":"text"},{"code":"Module@Other.symbols.json","type":"codeVoice"},{"text":" graphs were","type":"text"},{"text":" ","type":"text"},{"text":"deleted.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"An internal type is missing."}],"type":"strong"},{"text":" Symbol graphs only contain public API.","type":"text"}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"Links","type":"heading","level":2,"text":"Links"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit","overridingTitle":"GardenKit","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"GardenKit"}]},{"text":", the example, with the full script","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/www.swift.org\/documentation\/docc\/","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit","type":"reference","isActive":true},{"text":", the symbol graph format","type":"text"}]}]}],"type":"unorderedList"}]}],"metadata":{"images":[{"type":"card","identifier":"card-docc.svg"}],"role":"article","modules":[{"name":"Haydar Karkin"}],"roleHeading":"Article","title":"Combining Generated and Manual Docs"},"abstract":[{"type":"text","text":"Building one documentation site from two sources: the API reference the"},{"type":"text","text":" "},{"type":"text","text":"compiler generates, and the articles I write by hand."}],"references":{"card-docc.svg":{"type":"image","variants":[{"url":"\/images\/ReleaseNotes\/card-docc.svg","traits":["1x","light"],"svgID":"bg"},{"url":"\/images\/ReleaseNotes\/card-docc~dark.svg","traits":["1x","dark"],"svgID":"bg"}],"alt":null,"identifier":"card-docc.svg"},"https://github.com/swiftlang/swift-docc-symbolkit":{"url":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit","type":"link","title":"SymbolKit","titleInlineContent":[{"type":"text","text":"SymbolKit"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit"},"doc://ReleaseNotes/documentation/ReleaseNotes":{"type":"topic","title":"Haydar Karkin","role":"collection","kind":"symbol","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","abstract":[{"type":"text","text":"Senior iOS Developer. I build iOS apps that keep working as they grow."}],"url":"\/documentation\/releasenotes"},"https://github.com/haydarKarkin/GardenKit/blob/main/scripts/generate_docs.sh":{"url":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh","type":"link","title":"in GardenKit","titleInlineContent":[{"type":"text","text":"in GardenKit"}],"identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh"},"https://www.swift.org/documentation/docc/formattinnt":{"url":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt","type":"link","title":"Formatting your documentation content","titleInlineContent":[{"type":"text","text":"Formatting your documentation content"}],"identifier":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt"},"card-async.svg":{"type":"image","variants":[{"url":"\/images\/ReleaseNotes\/card-async.svg","traits":["1x","light"],"svgID":"bg"},{"url":"\/images\/ReleaseNotes\/card-async~dark.svg","traits":["1x","dark"],"svgID":"bg"}],"alt":"An input timeline throttled to one element per window","identifier":"card-async.svg"},"doc://ReleaseNotes/documentation/ReleaseNotes/AsyncSequenceOperator":{"type":"topic","title":"Writing Your Own AsyncSequence Operator","role":"article","images":[{"type":"card","identifier":"card-async.svg"}],"kind":"article","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator","abstract":[{"type":"text","text":"What it takes to add an operator like "},{"code":"throttleFirst","type":"codeVoice"},{"type":"text","text":" to "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"how to test it without waiting for real time to pass."}],"url":"\/documentation\/releasenotes\/asyncsequenceoperator"},"https://www.swift.org/documentation/docc/":{"url":"https:\/\/www.swift.org\/documentation\/docc\/","type":"link","title":"DocC documentation","titleInlineContent":[{"type":"text","text":"DocC documentation"}],"identifier":"https:\/\/www.swift.org\/documentation\/docc\/"},"https://github.com/haydarKarkin/GardenKit":{"checksum":null,"url":"https:\/\/github.com\/haydarKarkin\/GardenKit","type":"download","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit"},"https://github.com/swiftlang/swift-docc-plugin":{"url":"https:\/\/github.com\/swiftlang\/swift-docc-plugin","type":"link","title":"swift-docc-plugin","titleInlineContent":[{"type":"text","text":"swift-docc-plugin"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-docc-plugin"}}}