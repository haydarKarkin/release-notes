{"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"This site uses the ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-docc-plugin","isActive":true},{"type":"text","text":". One command and it works,"},{"text":" ","type":"text"},{"text":"because this is a Swift package with a single target.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In bigger projects the setup is not that simple. An Xcode project with many"},{"type":"text","text":" "},{"type":"text","text":"targets, a framework whose docs live in a separate folder, a site that also"},{"type":"text","text":" "},{"text":"carries onboarding pages. In those cases the plugin is not enough and you have","type":"text"},{"text":" ","type":"text"},{"text":"to run ","type":"text"},{"code":"docc","type":"codeVoice"},{"text":" yourself.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Here is how I do it. Every step is implemented in "},{"identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit","isActive":true,"type":"reference"},{"type":"text","text":", a"},{"type":"text","text":" "},{"type":"text","text":"small package that only exists to be documented, so you can read the real"},{"text":" ","type":"text"},{"text":"files instead of my snippets.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"The two halves","level":2,"type":"heading","anchor":"The-two-halves"},{"inlineContent":[{"text":"DocC can render two kinds of content.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Generated API reference."}],"type":"strong"},{"text":" Types and functions with their doc comments. You","type":"text"},{"type":"text","text":" "},{"type":"text","text":"never write these pages. The compiler describes your module in a "},{"inlineContent":[{"type":"text","text":"symbol"},{"text":" ","type":"text"},{"type":"text","text":"graph"}],"type":"emphasis"},{"text":", one JSON file per module, and DocC turns it into pages.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual documentation."}],"type":"strong"},{"text":" Articles and guides you write as Markdown inside a","type":"text"},{"type":"text","text":" "},{"inlineContent":[{"text":"documentation catalog","type":"text"}],"type":"emphasis"},{"text":", a folder ending in ","type":"text"},{"type":"codeVoice","code":".docc"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Alone, neither is enough. The API reference says what a function returns, but","type":"text"},{"text":" ","type":"text"},{"text":"not why the feature exists. The guide explains the idea, but cannot link into","type":"text"},{"text":" ","type":"text"},{"text":"the code. Putting them together is one flag. The rest is the work around it.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"1. Write the doc comments","level":2,"anchor":"1-Write-the-doc-comments","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated pages are only as good as the comments in the code. A one line"},{"type":"text","text":" "},{"text":"summary, then details, then the parameters. Keep the summary to one sentence,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"because DocC reuses it as the subtitle in every list."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only "},{"type":"codeVoice","code":"public"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"open"},{"type":"text","text":" symbols end up in the symbol graph, so"},{"text":" ","type":"text"},{"type":"text","text":"never show up on the website."}]},{"type":"thematicBreak"},{"text":"2. Add a catalog","type":"heading","anchor":"2-Add-a-catalog","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The catalog can live anywhere. It does not have to be inside a target, because"},{"text":" ","type":"text"},{"type":"text","text":"you pass its path to "},{"code":"docc","type":"codeVoice"},{"type":"text","text":" directly:"}]},{"type":"codeListing","code":["doc\/","└── GardenKit.docc\/","    ├── GardenKit.md      # landing page","    └── Guides\/"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"DocC flattens the catalog and finds pages by file name, so the folders are","type":"text"},{"type":"text","text":" "},{"text":"only for your own order. Keep the file names unique.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"One page becomes the front door. If you title a file with the module name in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"double backticks, DocC merges it into the generated module page:"},{"text":" ","type":"text"},{"type":"text","text":"becomes the overview and your "},{"code":"Topics","type":"codeVoice"},{"text":" groups set the order of everything","type":"text"},{"text":" ","type":"text"},{"text":"below. That is what GardenKit and this site do.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"text":"3. Get the symbol graphs","anchor":"3-Get-the-symbol-graphs","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Now the generated half. Ask the compiler for symbol graphs while","type":"text"}]},{"type":"codeListing","code":["xcodebuild build \\","    -scheme \"GardenKit\" \\","    -destination \"generic\/platform=iOS Simulator\" \\","    -derivedDataPath \"$build_dir\" \\","    -quiet \\","    OTHER_SWIFT_FLAGS=\"\\$(inherited) -emit-symbol-graph -emit-symbol-graph-dir $symbol_graphs_dir\""],"syntax":"bash"},{"inlineContent":[{"type":"text","text":"Three details matter here."}],"type":"paragraph"},{"inlineContent":[{"code":"generic\/platform=iOS Simulator","type":"codeVoice"},{"type":"text","text":" builds for the simulator SDK without picking"},{"type":"text","text":" "},{"type":"text","text":"a device, so codesigning never runs. A docs job has nothing to s"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\$(inherited)"},{"type":"text","text":" keeps the flags the project already sets. If you drop it, the"},{"type":"text","text":" "},{"text":"module compiles differently and you will not notice right away.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"build","type":"codeVoice"},{"type":"text","text":", not "},{"type":"codeVoice","code":"docbuild"},{"text":". ","type":"text"},{"code":"xcodebuild docbuild","type":"codeVoice"},{"type":"text","text":" looks easier, but"},{"text":" ","type":"text"},{"type":"text","text":"documentation for the whole dependency tree. If one of those dependencies has"},{"type":"text","text":" "},{"type":"text","text":"Objective-C headers, DocC’s header pass can fail with duplicate symbol errors"},{"type":"text","text":" "},{"type":"text","text":"and the build stops. A plain "},{"type":"codeVoice","code":"build"},{"type":"text","text":" never runs that pass. It on"},{"text":" ","type":"text"},{"type":"text","text":"the Swift symbol graphs, which is all DocC needs. This took me a while to"},{"type":"text","text":" "},{"type":"text","text":"figure out."}]},{"type":"thematicBreak"},{"anchor":"4-Keep-only-your-module","text":"4. Keep only your module","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The build writes a graph for every module it compiled, including"},{"type":"text","text":" "},{"type":"text","text":"dependencies. If you pass all of them to DocC, your dependencies"},{"type":"text","text":" "},{"text":"your website:","type":"text"}]},{"code":["find \"$symbol_graphs_dir\" -type f -name '*.symbols.json' \\","    ! -name 'GardenKit.symbols.json' \\","    ! -name 'GardenKit@*.symbols.json' \\","    -delete"],"type":"codeListing","syntax":"bash"},{"type":"paragraph","inlineContent":[{"text":"Both patterns are needed. ","type":"text"},{"code":"GardenKit.symbols.json","type":"codeVoice"},{"text":" has your own symbols.","type":"text"},{"text":" ","type":"text"},{"code":"GardenKit@Foundation.symbols.json","type":"codeVoice"},{"text":" is an extension graph, one per module you","type":"text"},{"text":" ","type":"text"},{"text":"extend. Delete those and every ","type":"text"},{"code":"extension Date","type":"codeVoice"},{"type":"text","text":" in your code qui"},{"type":"text","text":" "},{"type":"text","text":"disappears from the site."}]},{"type":"thematicBreak"},{"level":2,"text":"5. Put them together","type":"heading","anchor":"5-Put-them-together"},{"type":"paragraph","inlineContent":[{"text":"This is the command everything was preparing for:","type":"text"}]},{"type":"codeListing","syntax":"bash","code":["xcrun docc convert \"doc\/GardenKit.docc\" \\","    --additional-symbol-graph-dir \"$symbol_graphs_dir\" \\","    --fallback-display-name \"GardenKit\" \\","    --fallback-bundle-identifier \"com.example.gardenkit\" \\","    --output-dir \"$output_dir\" \\","    --transform-for-static-hosting \\","    --emit-digest"]},{"inlineContent":[{"type":"codeVoice","code":"--additional-symbol-graph-dir"},{"text":" is the flag that merges the two","type":"text"},{"text":" ","type":"text"},{"text":"symbol links in your articles resolve because of it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The two "},{"code":"--fallback-*","type":"codeVoice"},{"type":"text","text":" options give DocC the metadata Xcode would normally"},{"type":"text","text":" "},{"type":"text","text":"pass for a target. A catalog you convert by hand has no target, so they are"},{"type":"text","text":" "},{"text":"required. ","type":"text"},{"code":"--transform-for-static-hosting","type":"codeVoice"},{"text":" makes the output serv","type":"text"},{"type":"text","text":" "},{"type":"text","text":"file host, and "},{"type":"codeVoice","code":"--emit-digest"},{"type":"text","text":" writes the index the search needs."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"While writing, use "},{"code":"preview","type":"codeVoice"},{"type":"text","text":" instead of "},{"code":"convert","type":"codeVoice"},{"type":"text","text":". Same options,"},{"text":" ","type":"text"},{"code":"localhost:8080","type":"codeVoice"},{"type":"text","text":", and reloads when you save a Markdown file. It reads the"},{"text":" ","type":"text"},{"text":"symbol graphs from the folder you already created, so there is no rebuild.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"6. Serve it","anchor":"6-Serve-it"},{"type":"paragraph","inlineContent":[{"text":"If the site is not at the root of the domain, pass the prefix or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"URL will be wrong:"}]},{"type":"codeListing","syntax":"bash","code":["xcrun docc convert … --hosting-base-path \"docs\""]},{"type":"paragraph","inlineContent":[{"text":"DocC does not write a root page either, so add a redirect:","type":"text"}]},{"type":"codeListing","code":["echo '<script>window.location.href += \"documentation\/gardenkit\"<\/script>' \\","    > \"$output_dir\/index.html\""],"syntax":"bash"},{"inlineContent":[{"type":"text","text":"That is the whole pipeline. I keep it in a script with a "},{"type":"codeVoice","code":"-o"},{"type":"text","text":" fl"},{"text":" ","type":"text"},{"type":"text","text":"the docs are previewed locally, with it they are converted for hosting. The"},{"type":"text","text":" "},{"type":"text","text":"full version is "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh"},{"type":"text","text":". In CI the output is just a folder of"},{"type":"text","text":" "},{"type":"text","text":"static files, so publishing it is a copy."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Common problems","level":2,"type":"heading","anchor":"Common-problems"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"Topic reference 'Plant' couldn't be resolved."}],"type":"strong"},{"type":"text","text":" The symbol graphs did"},{"text":" ","type":"text"},{"text":"not reach DocC. Check the path you passed, and that pruning did not delete","type":"text"},{"text":" ","type":"text"},{"text":"your own graph.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extensions are missing."}]},{"text":" The ","type":"text"},{"code":"Module@Other.symbols.json","type":"codeVoice"},{"text":" graphs were","type":"text"},{"text":" ","type":"text"},{"text":"deleted.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"An internal type is missing.","type":"text"}],"type":"strong"},{"type":"text","text":" Symbol graphs only contain public API."}]}]}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Links","text":"Links","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"GardenKit","type":"text"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit","overridingTitle":"GardenKit"},{"text":", the example, with the full script","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"https:\/\/www.swift.org\/documentation\/docc\/","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit","type":"reference","isActive":true},{"type":"text","text":", the symbol graph format"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator"],"generated":true,"anchor":"Patch-Notes","title":"Patch Notes"}],"sections":[],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"Haydar Karkin"}],"roleHeading":"Article","title":"Combining Generated and Manual Docs"},"abstract":[{"text":"Building one documentation site from two sources: the API reference the","type":"text"},{"text":" ","type":"text"},{"text":"compiler generates, and the articles I write by hand.","type":"text"}],"variants":[{"paths":["\/documentation\/releasenotes\/doccpipeline"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","type":"topic","kind":"symbol","title":"Haydar Karkin","role":"collection","abstract":[{"text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}],"url":"\/documentation\/releasenotes"},"doc://ReleaseNotes/documentation/ReleaseNotes/AsyncSequenceOperator":{"url":"\/documentation\/releasenotes\/asyncsequenceoperator","role":"article","type":"topic","title":"Writing Your Own AsyncSequence Operator","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator","abstract":[{"type":"text","text":"What it takes to add an operator like "},{"type":"codeVoice","code":"throttleFirst"},{"type":"text","text":" to "},{"type":"codeVoice","code":"AsyncSequence"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"how to test it without waiting for real time to pass.","type":"text"}],"kind":"article"},"https://github.com/haydarKarkin/GardenKit/blob/main/scripts/generate_docs.sh":{"title":"in GardenKit","type":"link","titleInlineContent":[{"text":"in GardenKit","type":"text"}],"url":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh"},"https://www.swift.org/documentation/docc/formattinnt":{"url":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt","identifier":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt","type":"link","titleInlineContent":[{"text":"Formatting your documentation content","type":"text"}],"title":"Formatting your documentation content"},"https://github.com/swiftlang/swift-docc-plugin":{"titleInlineContent":[{"type":"text","text":"swift-docc-plugin"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-docc-plugin","title":"swift-docc-plugin","url":"https:\/\/github.com\/swiftlang\/swift-docc-plugin","type":"link"},"https://www.swift.org/documentation/docc/":{"type":"link","identifier":"https:\/\/www.swift.org\/documentation\/docc\/","url":"https:\/\/www.swift.org\/documentation\/docc\/","title":"DocC documentation","titleInlineContent":[{"type":"text","text":"DocC documentation"}]},"https://github.com/haydarKarkin/GardenKit":{"url":"https:\/\/github.com\/haydarKarkin\/GardenKit","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit","type":"link","titleInlineContent":[{"text":"GardenKit","type":"text"}],"title":"GardenKit"},"https://github.com/swiftlang/swift-docc-symbolkit":{"titleInlineContent":[{"type":"text","text":"SymbolKit"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit","title":"SymbolKit","url":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit","type":"link"}}}