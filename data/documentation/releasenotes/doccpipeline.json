{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline"},"metadata":{"title":"Combining Generated and Manual Docs","roleHeading":"Article","modules":[{"name":"Haydar Karkin"}],"role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Building one documentation site from two sources: the API reference the"},{"type":"text","text":" "},{"type":"text","text":"compiler generates, and the articles I write by hand."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"This site uses the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-docc-plugin"},{"type":"text","text":". One command and it works,"},{"type":"text","text":" "},{"type":"text","text":"because this is a Swift package with a single target."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In bigger projects the setup is not that simple. An Xcode project with many"},{"type":"text","text":" "},{"type":"text","text":"targets, a framework whose docs live in a separate folder, a site that also"},{"type":"text","text":" "},{"type":"text","text":"carries onboarding pages. In those cases the plugin is not enough and you have"},{"type":"text","text":" "},{"type":"text","text":"to run "},{"type":"codeVoice","code":"docc"},{"type":"text","text":" yourself."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Here is how I do it. Every step is implemented in ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit"},{"type":"text","text":", a"},{"type":"text","text":" "},{"type":"text","text":"small package that only exists to be documented, so you can read the real"},{"type":"text","text":" "},{"type":"text","text":"files instead of my snippets."}]},{"type":"thematicBreak"},{"anchor":"The-two-halves","text":"The two halves","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"DocC can render two kinds of content."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Generated API reference."}]},{"type":"text","text":" Types and functions with their doc comments. You"},{"type":"text","text":" "},{"type":"text","text":"never write these pages. The compiler describes your module in a "},{"inlineContent":[{"type":"text","text":"symbol"},{"type":"text","text":" "},{"type":"text","text":"graph"}],"type":"emphasis"},{"type":"text","text":", one JSON file per module, and DocC turns it into pages."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual documentation."}],"type":"strong"},{"type":"text","text":" Articles and guides you write as Markdown inside a"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"documentation catalog"}],"type":"emphasis"},{"text":", a folder ending in ","type":"text"},{"type":"codeVoice","code":".docc"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alone, neither is enough. The API reference says what a function returns, but"},{"type":"text","text":" "},{"type":"text","text":"not why the feature exists. The guide explains the idea, but cannot link into"},{"type":"text","text":" "},{"type":"text","text":"the code. Putting them together is one flag. The rest is the work around it."}]},{"type":"thematicBreak"},{"type":"heading","text":"1. Write the doc comments","level":2,"anchor":"1-Write-the-doc-comments"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated pages are only as good as the comments in the code. A one line"},{"type":"text","text":" "},{"type":"text","text":"summary, then details, then the parameters. Keep the summary to one sentence,"},{"type":"text","text":" "},{"type":"text","text":"because DocC reuses it as the subtitle in every list."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only "},{"code":"public","type":"codeVoice"},{"type":"text","text":" and "},{"code":"open","type":"codeVoice"},{"type":"text","text":" symbols end up in the symbol graph, so"},{"type":"text","text":" "},{"type":"text","text":"never show up on the website."}]},{"type":"thematicBreak"},{"type":"heading","text":"2. Add a catalog","level":2,"anchor":"2-Add-a-catalog"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The catalog can live anywhere. It does not have to be inside a target, because"},{"type":"text","text":" "},{"type":"text","text":"you pass its path to "},{"code":"docc","type":"codeVoice"},{"type":"text","text":" directly:"}]},{"type":"codeListing","syntax":null,"code":["doc\/","└── GardenKit.docc\/","    ├── GardenKit.md      # landing page","    └── Guides\/"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"DocC flattens the catalog and finds pages by file name, so the folders are"},{"type":"text","text":" "},{"type":"text","text":"only for your own order. Keep the file names unique."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One page becomes the front door. If you title a file with the module name in"},{"type":"text","text":" "},{"type":"text","text":"double backticks, DocC merges it into the generated module page:"},{"type":"text","text":" "},{"type":"text","text":"becomes the overview and your "},{"type":"codeVoice","code":"Topics"},{"type":"text","text":" groups set the order of everything"},{"type":"text","text":" "},{"type":"text","text":"below. That is what GardenKit and this site do."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"3-Get-the-symbol-graphs","level":2,"text":"3. Get the symbol graphs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now the generated half. Ask the compiler for symbol graphs while"}]},{"type":"codeListing","syntax":"bash","code":["xcodebuild build \\","    -scheme \"GardenKit\" \\","    -destination \"generic\/platform=iOS Simulator\" \\","    -derivedDataPath \"$build_dir\" \\","    -quiet \\","    OTHER_SWIFT_FLAGS=\"\\$(inherited) -emit-symbol-graph -emit-symbol-graph-dir $symbol_graphs_dir\""]},{"inlineContent":[{"type":"text","text":"Three details matter here."}],"type":"paragraph"},{"inlineContent":[{"code":"generic\/platform=iOS Simulator","type":"codeVoice"},{"type":"text","text":" builds for the simulator SDK without picking"},{"type":"text","text":" "},{"type":"text","text":"a device, so codesigning never runs. A docs job has nothing to s"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\$(inherited)"},{"type":"text","text":" keeps the flags the project already sets. If you drop it, the"},{"type":"text","text":" "},{"type":"text","text":"module compiles differently and you will not notice right away."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"build"},{"type":"text","text":", not "},{"type":"codeVoice","code":"docbuild"},{"type":"text","text":". "},{"type":"codeVoice","code":"xcodebuild docbuild"},{"type":"text","text":" looks easier, but"},{"type":"text","text":" "},{"type":"text","text":"documentation for the whole dependency tree. If one of those dependencies has"},{"type":"text","text":" "},{"type":"text","text":"Objective-C headers, DocC’s header pass can fail with duplicate symbol errors"},{"type":"text","text":" "},{"type":"text","text":"and the build stops. A plain "},{"type":"codeVoice","code":"build"},{"type":"text","text":" never runs that pass. It on"},{"type":"text","text":" "},{"type":"text","text":"the Swift symbol graphs, which is all DocC needs. This took me a while to"},{"type":"text","text":" "},{"type":"text","text":"figure out."}]},{"type":"thematicBreak"},{"text":"4. Keep only your module","anchor":"4-Keep-only-your-module","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The build writes a graph for every module it compiled, including"},{"type":"text","text":" "},{"type":"text","text":"dependencies. If you pass all of them to DocC, your dependencies"},{"type":"text","text":" "},{"type":"text","text":"your website:"}]},{"type":"codeListing","syntax":"bash","code":["find \"$symbol_graphs_dir\" -type f -name '*.symbols.json' \\","    ! -name 'GardenKit.symbols.json' \\","    ! -name 'GardenKit@*.symbols.json' \\","    -delete"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both patterns are needed. "},{"code":"GardenKit.symbols.json","type":"codeVoice"},{"text":" has your own symbols.","type":"text"},{"text":" ","type":"text"},{"code":"GardenKit@Foundation.symbols.json","type":"codeVoice"},{"type":"text","text":" is an extension graph, one per module you"},{"type":"text","text":" "},{"type":"text","text":"extend. Delete those and every "},{"type":"codeVoice","code":"extension Date"},{"type":"text","text":" in your code qui"},{"type":"text","text":" "},{"type":"text","text":"disappears from the site."}]},{"type":"thematicBreak"},{"text":"5. Put them together","anchor":"5-Put-them-together","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This is the command everything was preparing for:"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["xcrun docc convert \"doc\/GardenKit.docc\" \\","    --additional-symbol-graph-dir \"$symbol_graphs_dir\" \\","    --fallback-display-name \"GardenKit\" \\","    --fallback-bundle-identifier \"com.example.gardenkit\" \\","    --output-dir \"$output_dir\" \\","    --transform-for-static-hosting \\","    --emit-digest"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"--additional-symbol-graph-dir"},{"text":" is the flag that merges the two","type":"text"},{"text":" ","type":"text"},{"text":"symbol links in your articles resolve because of it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two "},{"type":"codeVoice","code":"--fallback-*"},{"type":"text","text":" options give DocC the metadata Xcode would normally"},{"type":"text","text":" "},{"type":"text","text":"pass for a target. A catalog you convert by hand has no target, so they are"},{"type":"text","text":" "},{"type":"text","text":"required. "},{"type":"codeVoice","code":"--transform-for-static-hosting"},{"type":"text","text":" makes the output serv"},{"type":"text","text":" "},{"type":"text","text":"file host, and "},{"type":"codeVoice","code":"--emit-digest"},{"type":"text","text":" writes the index the search needs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While writing, use "},{"type":"codeVoice","code":"preview"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"convert"},{"type":"text","text":". Same options,"},{"type":"text","text":" "},{"type":"codeVoice","code":"localhost:8080"},{"type":"text","text":", and reloads when you save a Markdown file. It reads the"},{"type":"text","text":" "},{"type":"text","text":"symbol graphs from the folder you already created, so there is no rebuild."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"6. Serve it","anchor":"6-Serve-it"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the site is not at the root of the domain, pass the prefix or"},{"type":"text","text":" "},{"type":"text","text":"URL will be wrong:"}]},{"type":"codeListing","syntax":"bash","code":["xcrun docc convert … --hosting-base-path \"docs\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"DocC does not write a root page either, so add a redirect:"}]},{"type":"codeListing","syntax":"bash","code":["echo '<script>window.location.href += \"documentation\/gardenkit\"<\/script>' \\","    > \"$output_dir\/index.html\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That is the whole pipeline. I keep it in a script with a "},{"type":"codeVoice","code":"-o"},{"type":"text","text":" fl"},{"type":"text","text":" "},{"type":"text","text":"the docs are previewed locally, with it they are converted for hosting. The"},{"type":"text","text":" "},{"type":"text","text":"full version is "},{"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh","isActive":true},{"type":"text","text":". In CI the output is just a folder of"},{"type":"text","text":" "},{"type":"text","text":"static files, so publishing it is a copy."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"Common problems","anchor":"Common-problems"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"Topic reference 'Plant' couldn't be resolved."}],"type":"strong"},{"type":"text","text":" The symbol graphs did"},{"type":"text","text":" "},{"type":"text","text":"not reach DocC. Check the path you passed, and that pruning did not delete"},{"type":"text","text":" "},{"type":"text","text":"your own graph."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Extensions are missing.","type":"text"}],"type":"strong"},{"type":"text","text":" The "},{"type":"codeVoice","code":"Module@Other.symbols.json"},{"type":"text","text":" graphs were"},{"type":"text","text":" "},{"type":"text","text":"deleted."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"An internal type is missing.","type":"text"}],"type":"strong"},{"type":"text","text":" Symbol graphs only contain public API."}]}]}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"Links","anchor":"Links"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"overridingTitle":"GardenKit","type":"reference","overridingTitleInlineContent":[{"text":"GardenKit","type":"text"}],"identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit","isActive":true},{"type":"text","text":", the example, with the full script"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/www.swift.org\/documentation\/docc\/","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit","isActive":true},{"type":"text","text":", the symbol graph format"}]}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/releasenotes\/doccpipeline"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"references":{"https://github.com/swiftlang/swift-docc-plugin":{"titleInlineContent":[{"type":"text","text":"swift-docc-plugin"}],"url":"https:\/\/github.com\/swiftlang\/swift-docc-plugin","type":"link","title":"swift-docc-plugin","identifier":"https:\/\/github.com\/swiftlang\/swift-docc-plugin"},"https://github.com/swiftlang/swift-docc-symbolkit":{"titleInlineContent":[{"type":"text","text":"SymbolKit"}],"url":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit","type":"link","title":"SymbolKit","identifier":"https:\/\/github.com\/swiftlang\/swift-docc-symbolkit"},"https://github.com/haydarKarkin/GardenKit/blob/main/scripts/generate_docs.sh":{"titleInlineContent":[{"type":"text","text":"in GardenKit"}],"url":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh","type":"link","title":"in GardenKit","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit\/blob\/main\/scripts\/generate_docs.sh"},"https://github.com/haydarKarkin/GardenKit":{"titleInlineContent":[{"type":"text","text":"GardenKit"}],"url":"https:\/\/github.com\/haydarKarkin\/GardenKit","type":"link","title":"GardenKit","identifier":"https:\/\/github.com\/haydarKarkin\/GardenKit"},"https://www.swift.org/documentation/docc/":{"titleInlineContent":[{"type":"text","text":"DocC documentation"}],"url":"https:\/\/www.swift.org\/documentation\/docc\/","type":"link","title":"DocC documentation","identifier":"https:\/\/www.swift.org\/documentation\/docc\/"},"https://www.swift.org/documentation/docc/formattinnt":{"titleInlineContent":[{"type":"text","text":"Formatting your documentation content"}],"url":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt","type":"link","title":"Formatting your documentation content","identifier":"https:\/\/www.swift.org\/documentation\/docc\/formattinnt"},"doc://ReleaseNotes/documentation/ReleaseNotes":{"type":"topic","url":"\/documentation\/releasenotes","abstract":[{"type":"text","text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —"},{"type":"text","text":" "},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}],"identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","kind":"symbol","role":"collection","title":"Haydar Karkin"}}}