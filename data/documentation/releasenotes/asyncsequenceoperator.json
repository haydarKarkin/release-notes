{"variants":[{"paths":["\/documentation\/releasenotes\/asyncsequenceoperator"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Writing Your Own AsyncSequence Operator","images":[{"identifier":"card-async.svg","type":"card"}],"modules":[{"name":"Haydar Karkin"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"sampleCodeDownload":{"kind":"sampleDownload","action":{"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","isActive":true,"type":"reference","overridingTitle":"View Throttling on GitHub"}},"abstract":[{"text":"What it takes to add an operator like ","type":"text"},{"code":"throttleFirst","type":"codeVoice"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":", and"},{"type":"text","text":" "},{"text":"how to test it without waiting for real time to pass.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Patch Notes","identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPersonalSite"],"anchor":"Patch-Notes"}],"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The standard library gives "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" the basics: "},{"type":"codeVoice","code":"map"},{"text":", ","type":"text"},{"type":"codeVoice","code":"filter"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"compactMap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"prefix","type":"codeVoice"},{"text":", ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":". Anything beyond that comes from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","isActive":true,"type":"reference"},{"text":" or from you.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sometimes writing it yourself is the better trade. The semantics you need may","type":"text"},{"text":" ","type":"text"},{"text":"not be the ones the library offers, or you may not want another dependency in","type":"text"},{"text":" ","type":"text"},{"text":"a shared module. Either way it is around thirty lines once you know the shape,","type":"text"},{"text":" ","type":"text"},{"text":"and the shape is what this article is about.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The example is ","type":"text"},{"code":"throttleFirst","type":"codeVoice"},{"text":": pass the first element of every time window","type":"text"},{"text":" ","type":"text"},{"text":"through, drop everything that arrives before the window is over. Working code","type":"text"},{"text":" ","type":"text"},{"text":"with tests is in the ","type":"text"},{"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","isActive":true,"type":"reference"},{"text":" repository.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"The-throttling-logic","text":"The throttling logic"},{"inlineContent":[{"text":"First the semantics, because “throttle” means different things in different","type":"text"},{"text":" ","type":"text"},{"text":"libraries. Mine is the leading edge variant. With a window of 100ms and","type":"text"},{"text":" ","type":"text"},{"text":"elements arriving at 0, 50, 110, 610 and 620ms:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Arrives at","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Result","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0ms"}],"type":"paragraph"}],[{"inlineContent":[{"text":"passes, window opens","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"50ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"dropped, window still open"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"110ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, new window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"610ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, new window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"620ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"dropped"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Now ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public mutating func next() async throws -> Element? {","    while let element = try await base.next() {","        let now = clock.now","","        if let windowStart, windowStart.duration(to: now) < interval {","            continue","        }","","        windowStart = now","        return element","    }","","    return nil","}"],"type":"codeListing"},{"inlineContent":[{"text":"The loop is the whole idea. Dropping an element does not mean returning","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"something, it means pulling the next one. A caller asking for one element can"},{"text":" ","type":"text"},{"text":"make us pull ten from the base sequence. When the base sequence ends we return","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and stop.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note what is missing: no timer, no ","type":"text"},{"type":"codeVoice","code":"Task"},{"type":"text","text":", no buffer. The operator only ever"},{"type":"text","text":" "},{"type":"text","text":"looks at the clock when an element arrives. That keeps it cheap, and it is"},{"type":"text","text":" "},{"type":"text","text":"also why cancellation needs no code of its own. There is nothing to cancel"},{"type":"text","text":" "},{"type":"text","text":"except the "},{"type":"codeVoice","code":"base.next()"},{"type":"text","text":" we are suspended on, and that already handles it."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"Inject-the-clock","text":"Inject the clock"},{"inlineContent":[{"type":"text","text":"The obvious version of the code above reads "},{"type":"codeVoice","code":"ContinuousClock.now"},{"type":"text","text":" directly."},{"type":"text","text":" "},{"type":"text","text":"Do not do that. Make the operator generic over the clock instead:"}],"type":"paragraph"},{"syntax":"swift","code":["public struct AsyncThrottleFirstSequence<Base: AsyncSequence, C: Clock>: AsyncSequence {","    public typealias Element = Base.Element","","    let base: Base","    let interval: C.Duration","    let clock: C","","    public struct Iterator: AsyncIteratorProtocol {","        var base: Base.AsyncIterator","        let interval: C.Duration","        let clock: C","        var windowStart: C.Instant?","","        \/\/ next() as above","    }","","    public func makeAsyncIterator() -> Iterator {","        Iterator(base: base.makeAsyncIterator(), interval: interval, clock: clock)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"It costs one generic parameter and it is the difference between tests that","type":"text"},{"text":" ","type":"text"},{"text":"sleep and tests that do not. More on that below.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two smaller decisions in the same area."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Clock"},{"type":"text","text":", not "},{"type":"codeVoice","code":"Date"},{"type":"text","text":". Wall clock time can jump backwards, on an NTP"},{"type":"text","text":" "},{"type":"text","text":"correction or when the user changes the date. A window measured with "},{"code":"Date","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"breaks when it does. "},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" only moves forward."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"text":" also keeps counting while the device is asleep, which is","type":"text"},{"text":" ","type":"text"},{"text":"what you want for throttling: if the app was suspended for an hour, the window","type":"text"},{"text":" ","type":"text"},{"text":"is over. If you want the opposite, ","type":"text"},{"code":"SuspendingClock","type":"codeVoice"},{"text":" is the other option.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"The-entry-point","text":"The entry point"},{"inlineContent":[{"text":"Nobody wants to write the generic type by hand, so add the operator to","type":"text"},{"text":" ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" and give it a default clock:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public extension AsyncSequence {","    func throttleFirst<C: Clock>(","        for interval: C.Duration,","        clock: C,","    ) -> AsyncThrottleFirstSequence<Self, C> {","        AsyncThrottleFirstSequence(base: self, interval: interval, clock: clock)","    }","","    func throttleFirst(","        for interval: Duration,","    ) -> AsyncThrottleFirstSequence<Self, ContinuousClock> {","        throttleFirst(for: interval, clock: ContinuousClock())","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Now it reads like any other operator:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["for try await update in updates.throttleFirst(for: .milliseconds(500)) {","    render(update)","}"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"Testing-without-waiting","text":"Testing without waiting"},{"inlineContent":[{"type":"text","text":"A time based operator tested with real time gives you a slow suite and flaky"},{"type":"text","text":" "},{"type":"text","text":"results on a loaded CI machine. Since the clock is injectable, we can do"},{"text":" ","type":"text"},{"text":"better.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trick is that a clock does not have to define its own instant type. Reuse"},{"type":"text","text":" "},{"code":"ContinuousClock.Instant","type":"codeVoice"},{"type":"text","text":" and there is no "},{"code":"InstantProtocol","type":"codeVoice"},{"type":"text","text":" conformance to"},{"type":"text","text":" "},{"type":"text","text":"write:"}]},{"type":"codeListing","syntax":"swift","code":["final class ManualClock: Clock, @unchecked Sendable {","    typealias Instant = ContinuousClock.Instant","","    private let lock = NSLock()","    private var instant = ContinuousClock.now","","    var now: Instant { lock.withLock { instant } }","    var minimumResolution: Duration { .zero }","","    func advance(by duration: Duration) {","        lock.withLock { instant = instant.advanced(by: duration) }","    }","","    func sleep(until deadline: Instant, tolerance: Duration?) async throws {}","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The empty "},{"code":"sleep","type":"codeVoice"},{"type":"text","text":" looks like cheating. It is safe here for one specific"},{"type":"text","text":" "},{"type":"text","text":"reason: our operator never sleeps, it only reads "},{"code":"now","type":"codeVoice"},{"type":"text","text":". An operator that does"},{"type":"text","text":" "},{"type":"text","text":"sleep, like "},{"code":"debounce","type":"codeVoice"},{"type":"text","text":", needs a clock that can actually park a task and wake"},{"type":"text","text":" "},{"type":"text","text":"it up, and that is a much bigger piece of test code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The second helper describes arrival times. It is a base sequence that moves"},{"type":"text","text":" "},{"type":"text","text":"the clock forward as it produces elements:"}]},{"type":"codeListing","syntax":"swift","code":["struct ScriptedSequence: AsyncSequence {","    let script: [(value: Int, after: Duration)]","    let clock: ManualClock","","    struct Iterator: AsyncIteratorProtocol {","        ...","        mutating func next() async -> Int? {","            guard index < script.count else { return nil }","","            let step = script[index]","            index += 1","            clock.advance(by: step.after)","            return step.value","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With those two, the test reads like the table from earlier:"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"drops elements that arrive inside the window\")","func dropsElementsInsideWindow() async throws {","    let clock = ManualClock()","    let base = ScriptedSequence(","        script: [","            (1, .zero),              \/\/ t = 0,   first element, passes","            (2, .milliseconds(50)),  \/\/ t = 50,  window still open, dropped","            (3, .milliseconds(60)),  \/\/ t = 110, window over, passes","            (4, .milliseconds(500)), \/\/ t = 610, window over, passes","            (5, .milliseconds(10)),  \/\/ t = 620, window still open, dropped","        ],","        clock: clock,","    )","","    let result = try await collect(base.throttleFirst(for: .milliseconds(100), clock: clock))","","    #expect(result == [1, 3, 4])","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No sleeps, no tolerances, and the expected output is obvious from the input."},{"type":"text","text":" "},{"type":"text","text":"The suite in the repository also covers the boundary case, an empty base"},{"text":" ","type":"text"},{"text":"sequence, and that errors from the base sequence are not swallowed. It runs in","type":"text"},{"text":" ","type":"text"},{"text":"about a millisecond.","type":"text"}]},{"inlineContent":[{"type":"text","text":"There is one test left on the real "},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", to exercise the default"},{"type":"text","text":" "},{"type":"text","text":"overload. It is written so that its assertion cannot depend on how fast the"},{"type":"text","text":" "},{"type":"text","text":"machine is: every element is buffered before iteration starts, so a one second"},{"type":"text","text":" "},{"type":"text","text":"window can only let the first one through. My first version of that test"},{"type":"text","text":" "},{"type":"text","text":"produced values 20ms apart and asserted that some of them got dropped. It"},{"type":"text","text":" "},{"type":"text","text":"failed the same day, on a loaded machine where each 20ms sleep took longer"},{"type":"text","text":" "},{"type":"text","text":"than the window. Even the smoke test should not measure time."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Two things that bite","level":2,"anchor":"Two-things-that-bite","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Filter before you throttle."}]},{"type":"text","text":" If the stream starts with a value you do not"},{"type":"text","text":" "},{"type":"text","text":"care about, an empty snapshot from a realtime database for example, that value"},{"type":"text","text":" "},{"type":"text","text":"opens the window and the first real value gets dropped. The fix is not in the"},{"type":"text","text":" "},{"type":"text","text":"operator. Filter the noise out first, so the window starts on data that"},{"type":"text","text":" "},{"type":"text","text":"matters:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["updates","    .filter { !$0.isEmpty }","    .throttleFirst(for: .milliseconds(500))"]},{"type":"paragraph","inlineContent":[{"text":"I lost time to this one, and it is not visible in any marble diagram.","type":"text"}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"The leading edge loses the last value."}],"type":"strong"},{"type":"text","text":" If an element is dropped and then"},{"type":"text","text":" "},{"type":"text","text":"the stream goes quiet, you never see it. For a progress counter that is fine."},{"type":"text","text":" "},{"type":"text","text":"For UI state it usually is not, because the state you are showing is one"},{"type":"text","text":" "},{"type":"text","text":"update behind reality. If that matters, you want the newest element of the"},{"type":"text","text":" "},{"type":"text","text":"window instead of the oldest, and that means buffering and waiting."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"When to use swift-async-algorithms instead","level":2,"anchor":"When-to-use-swift-async-algorithms-instead","type":"heading"},{"inlineContent":[{"type":"text","text":"The package has "},{"code":"throttle(for:clock:latest:)","type":"codeVoice"},{"type":"text","text":", and it does not work the way"},{"type":"text","text":" "},{"type":"text","text":"the operator above does. From "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md"},{"type":"text","text":":"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"If values are produced by the base "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" the throttle does not"},{"type":"text","text":" "},{"type":"text","text":"resume its next iterator until the period has elapsed or unless a terminal"},{"type":"text","text":" "},{"type":"text","text":"event is encountered."}],"type":"paragraph"}],"style":"note","type":"aside"},{"inlineContent":[{"type":"text","text":"So it waits out the window and then emits, and "},{"type":"codeVoice","code":"latest"},{"type":"text","text":" decides whether you"},{"type":"text","text":" "},{"type":"text","text":"get the newest or the oldest element of that window. Use it when you want the"},{"type":"text","text":" "},{"type":"text","text":"newest value, or a reduction over the window, or simply do not want to own"},{"type":"text","text":" "},{"type":"text","text":"this code."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Write your own when you want the leading edge with no waiting and no"},{"type":"text","text":" "},{"type":"text","text":"buffering, when you cannot add a dependency, or when you want to understand"},{"type":"text","text":" "},{"type":"text","text":"what these operators actually do. The last reason is the one that got me"},{"type":"text","text":" "},{"type":"text","text":"started."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Links","level":2,"anchor":"Links","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"Throttling","type":"text"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","overridingTitle":"Throttling"},{"type":"text","text":", the example with tests"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"swift-async-algorithms","type":"text"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","overridingTitle":"swift-async-algorithms"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime"},{"type":"text","text":", the same semantics in another library"}]}]}],"type":"unorderedList"}]}],"references":{"https://rxjs.dev/api/operators/throttleTime":{"title":"RxJS throttleTime","titleInlineContent":[{"text":"RxJS throttleTime","type":"text"}],"url":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","type":"link","identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime"},"doc://ReleaseNotes/documentation/ReleaseNotes/DoccPersonalSite":{"url":"\/documentation\/releasenotes\/doccpersonalsite","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPersonalSite","kind":"article","title":"Turning DocC into a Personal Site","role":"article","images":[{"type":"card","identifier":"card-site.svg"}],"type":"topic","abstract":[{"type":"text","text":"What a personal site actually needs, and how far DocC gets you with each of"},{"type":"text","text":" "},{"type":"text","text":"those things."}]},"doc://ReleaseNotes/documentation/ReleaseNotes/DoccPipeline":{"url":"\/documentation\/releasenotes\/doccpipeline","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","title":"Combining Generated and Manual Docs","kind":"article","role":"article","images":[{"type":"card","identifier":"card-docc.svg"}],"type":"topic","abstract":[{"type":"text","text":"Building one documentation site from two sources: the API reference the"},{"type":"text","text":" "},{"type":"text","text":"compiler generates, and the articles I write by hand."}]},"https://github.com/apple/swift-async-algorithms/blob/main/Sources/AsyncAlgorithms/AsyncAlgorithms.docc/Guides/Throttle.md":{"title":"its documentation","titleInlineContent":[{"text":"its documentation","type":"text"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","type":"link","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md"},"https://github.com/apple/swift-async-algorithms":{"title":"swift-async-algorithms","titleInlineContent":[{"text":"swift-async-algorithms","type":"text"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms","type":"link","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms"},"https://github.com/haydarKarkin/Throttling":{"checksum":null,"url":"https:\/\/github.com\/haydarKarkin\/Throttling","type":"download","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling"},"doc://ReleaseNotes/documentation/ReleaseNotes":{"abstract":[{"type":"text","text":"Senior iOS Developer. I build iOS apps that keep working as they grow."}],"role":"collection","kind":"symbol","title":"Haydar Karkin","type":"topic","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","url":"\/documentation\/releasenotes"},"card-docc.svg":{"alt":"A document page","variants":[{"url":"\/images\/ReleaseNotes\/card-docc.svg","svgID":"bg","traits":["1x","light"]},{"url":"\/images\/ReleaseNotes\/card-docc~dark.svg","svgID":"bg","traits":["1x","dark"]}],"type":"image","identifier":"card-docc.svg"},"card-async.svg":{"alt":null,"variants":[{"url":"\/images\/ReleaseNotes\/card-async.svg","svgID":"bg","traits":["1x","light"]},{"url":"\/images\/ReleaseNotes\/card-async~dark.svg","svgID":"bg","traits":["1x","dark"]}],"type":"image","identifier":"card-async.svg"},"card-site.svg":{"type":"image","alt":"A browser window with a header bar and two cards","identifier":"card-site.svg","variants":[{"svgID":"bg","url":"\/images\/ReleaseNotes\/card-site.svg","traits":["1x","light"]},{"url":"\/images\/ReleaseNotes\/card-site~dark.svg","svgID":"bg","traits":["1x","dark"]}]}}}