{"sections":[],"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Haydar Karkin"}],"title":"Writing Your Own AsyncSequence Operator"},"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/releasenotes\/asyncsequenceoperator"]}],"kind":"article","abstract":[{"type":"text","text":"What it takes to add an operator like "},{"type":"codeVoice","code":"throttleFirst"},{"type":"text","text":" to "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"how to test it without waiting for real time to pass."}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The standard library gives ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" the basics: ","type":"text"},{"code":"map","type":"codeVoice"},{"text":", ","type":"text"},{"code":"filter","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"compactMap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"prefix","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":". Anything beyond that comes from"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","isActive":true},{"type":"text","text":" or from you."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sometimes writing it yourself is the better trade. The semantics you need may"},{"type":"text","text":" "},{"type":"text","text":"not be the ones the library offers, or you may not want another dependency in"},{"type":"text","text":" "},{"type":"text","text":"a shared module. Either way it is around thirty lines once you know the shape,"},{"type":"text","text":" "},{"type":"text","text":"and the shape is what this article is about."}]},{"type":"paragraph","inlineContent":[{"text":"The example is ","type":"text"},{"code":"throttleFirst","type":"codeVoice"},{"text":": pass the first element of every time window","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"through, drop everything that arrives before the window is over. Working code"},{"type":"text","text":" "},{"type":"text","text":"with tests is in the "},{"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","isActive":true},{"type":"text","text":" repository."}]},{"type":"thematicBreak"},{"anchor":"The-throttling-logic","type":"heading","text":"The throttling logic","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"First the semantics, because “throttle” means different things in different"},{"type":"text","text":" "},{"text":"libraries. Mine is the leading edge variant. With a window of 100ms and","type":"text"},{"text":" ","type":"text"},{"text":"elements arriving at 0, 50, 110, 610 and 620ms:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Arrives at","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Result","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"0ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"passes, window opens","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"50ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"dropped, window still open","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"110ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, new window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"610ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, new window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"620ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"dropped"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Now "},{"type":"codeVoice","code":"next()"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public mutating func next() async throws -> Element? {","    while let element = try await base.next() {","        let now = clock.now","","        if let windowStart, windowStart.duration(to: now) < interval {","            continue","        }","","        windowStart = now","        return element","    }","","    return nil","}"]},{"inlineContent":[{"type":"text","text":"The loop is the whole idea. Dropping an element does not mean returning"},{"type":"text","text":" "},{"type":"text","text":"something, it means pulling the next one. A caller asking for one element can"},{"type":"text","text":" "},{"type":"text","text":"make us pull ten from the base sequence. When the base sequence ends we return"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and stop."}],"type":"paragraph"},{"inlineContent":[{"text":"Note what is missing: no timer, no ","type":"text"},{"code":"Task","type":"codeVoice"},{"type":"text","text":", no buffer. The operator only ever"},{"type":"text","text":" "},{"type":"text","text":"looks at the clock when an element arrives. That keeps it cheap, and it is"},{"type":"text","text":" "},{"type":"text","text":"also why cancellation needs no code of its own. There is nothing to cancel"},{"type":"text","text":" "},{"type":"text","text":"except the "},{"type":"codeVoice","code":"base.next()"},{"type":"text","text":" we are suspended on, and that already handles it."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"Inject-the-clock","type":"heading","text":"Inject the clock","level":2},{"type":"paragraph","inlineContent":[{"text":"The obvious version of the code above reads ","type":"text"},{"code":"ContinuousClock.now","type":"codeVoice"},{"text":" directly.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Do not do that. Make the operator generic over the clock instead:"}]},{"type":"codeListing","syntax":"swift","code":["public struct AsyncThrottleFirstSequence<Base: AsyncSequence, C: Clock>: AsyncSequence {","    public typealias Element = Base.Element","","    let base: Base","    let interval: C.Duration","    let clock: C","","    public struct Iterator: AsyncIteratorProtocol {","        var base: Base.AsyncIterator","        let interval: C.Duration","        let clock: C","        var windowStart: C.Instant?","","        \/\/ next() as above","    }","","    public func makeAsyncIterator() -> Iterator {","        Iterator(base: base.makeAsyncIterator(), interval: interval, clock: clock)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"It costs one generic parameter and it is the difference between tests that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"sleep and tests that do not. More on that below."}]},{"inlineContent":[{"type":"text","text":"Two smaller decisions in the same area."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":", not ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":". Wall clock time can jump backwards, on an NTP","type":"text"},{"text":" ","type":"text"},{"text":"correction or when the user changes the date. A window measured with ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" ","type":"text"},{"text":"breaks when it does. ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":" only moves forward.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"text":" also keeps counting while the device is asleep, which is","type":"text"},{"text":" ","type":"text"},{"text":"what you want for throttling: if the app was suspended for an hour, the window","type":"text"},{"text":" ","type":"text"},{"text":"is over. If you want the opposite, ","type":"text"},{"code":"SuspendingClock","type":"codeVoice"},{"text":" is the other option.","type":"text"}]},{"type":"thematicBreak"},{"anchor":"The-entry-point","text":"The entry point","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Nobody wants to write the generic type by hand, so add the operator to"},{"text":" ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" and give it a default clock:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public extension AsyncSequence {","    func throttleFirst<C: Clock>(","        for interval: C.Duration,","        clock: C,","    ) -> AsyncThrottleFirstSequence<Self, C> {","        AsyncThrottleFirstSequence(base: self, interval: interval, clock: clock)","    }","","    func throttleFirst(","        for interval: Duration,","    ) -> AsyncThrottleFirstSequence<Self, ContinuousClock> {","        throttleFirst(for: interval, clock: ContinuousClock())","    }","}"]},{"inlineContent":[{"type":"text","text":"Now it reads like any other operator:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["for try await update in updates.throttleFirst(for: .milliseconds(500)) {","    render(update)","}"]},{"type":"thematicBreak"},{"text":"Testing without waiting","anchor":"Testing-without-waiting","type":"heading","level":2},{"inlineContent":[{"text":"A time based operator tested with real time gives you a slow suite and flaky","type":"text"},{"type":"text","text":" "},{"type":"text","text":"results on a loaded CI machine. Since the clock is injectable, we can do"},{"type":"text","text":" "},{"text":"better.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The trick is that a clock does not have to define its own instant type. Reuse","type":"text"},{"text":" ","type":"text"},{"code":"ContinuousClock.Instant","type":"codeVoice"},{"text":" and there is no ","type":"text"},{"code":"InstantProtocol","type":"codeVoice"},{"text":" conformance to","type":"text"},{"text":" ","type":"text"},{"text":"write:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["final class ManualClock: Clock, @unchecked Sendable {","    typealias Instant = ContinuousClock.Instant","","    private let lock = NSLock()","    private var instant = ContinuousClock.now","","    var now: Instant { lock.withLock { instant } }","    var minimumResolution: Duration { .zero }","","    func advance(by duration: Duration) {","        lock.withLock { instant = instant.advanced(by: duration) }","    }","","    func sleep(until deadline: Instant, tolerance: Duration?) async throws {}","}"]},{"type":"paragraph","inlineContent":[{"text":"The empty ","type":"text"},{"code":"sleep","type":"codeVoice"},{"text":" looks like cheating. It is safe here for one specific","type":"text"},{"text":" ","type":"text"},{"text":"reason: our operator never sleeps, it only reads ","type":"text"},{"code":"now","type":"codeVoice"},{"text":". An operator that does","type":"text"},{"text":" ","type":"text"},{"text":"sleep, like ","type":"text"},{"code":"debounce","type":"codeVoice"},{"type":"text","text":", needs a clock that can actually park a task and wake"},{"type":"text","text":" "},{"type":"text","text":"it up, and that is a much bigger piece of test code."}]},{"type":"paragraph","inlineContent":[{"text":"The second helper describes arrival times. It is a base sequence that moves","type":"text"},{"text":" ","type":"text"},{"text":"the clock forward as it produces elements:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ScriptedSequence: AsyncSequence {","    let script: [(value: Int, after: Duration)]","    let clock: ManualClock","","    struct Iterator: AsyncIteratorProtocol {","        ...","        mutating func next() async -> Int? {","            guard index < script.count else { return nil }","","            let step = script[index]","            index += 1","            clock.advance(by: step.after)","            return step.value","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"With those two, the test reads like the table from earlier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"drops elements that arrive inside the window\")","func dropsElementsInsideWindow() async throws {","    let clock = ManualClock()","    let base = ScriptedSequence(","        script: [","            (1, .zero),              \/\/ t = 0,   first element, passes","            (2, .milliseconds(50)),  \/\/ t = 50,  window still open, dropped","            (3, .milliseconds(60)),  \/\/ t = 110, window over, passes","            (4, .milliseconds(500)), \/\/ t = 610, window over, passes","            (5, .milliseconds(10)),  \/\/ t = 620, window still open, dropped","        ],","        clock: clock,","    )","","    let result = try await collect(base.throttleFirst(for: .milliseconds(100), clock: clock))","","    #expect(result == [1, 3, 4])","}"]},{"type":"paragraph","inlineContent":[{"text":"No sleeps, no tolerances, and the expected output is obvious from the input.","type":"text"},{"text":" ","type":"text"},{"text":"The suite in the repository also covers the boundary case, an empty base","type":"text"},{"text":" ","type":"text"},{"text":"sequence, and that errors from the base sequence are not swallowed. It runs in","type":"text"},{"text":" ","type":"text"},{"text":"a few milliseconds. I keep one test on the real ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":" as a smoke","type":"text"},{"text":" ","type":"text"},{"text":"test, and that one is deliberately loose about what it asserts.","type":"text"}]},{"type":"thematicBreak"},{"anchor":"Two-things-that-bite","type":"heading","text":"Two things that bite","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Filter before you throttle.","type":"text"}]},{"text":" If the stream starts with a value you do not","type":"text"},{"text":" ","type":"text"},{"text":"care about, an empty snapshot from a realtime database for example, that value","type":"text"},{"text":" ","type":"text"},{"text":"opens the window and the first real value gets dropped. The fix is not in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"operator. Filter the noise out first, so the window starts on data that"},{"type":"text","text":" "},{"type":"text","text":"matters:"}]},{"syntax":"swift","type":"codeListing","code":["updates","    .filter { !$0.isEmpty }","    .throttleFirst(for: .milliseconds(500))"]},{"type":"paragraph","inlineContent":[{"text":"I lost time to this one, and it is not visible in any marble diagram.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The leading edge loses the last value.","type":"text"}],"type":"strong"},{"text":" If an element is dropped and then","type":"text"},{"text":" ","type":"text"},{"text":"the stream goes quiet, you never see it. For a progress counter that is fine.","type":"text"},{"text":" ","type":"text"},{"text":"For UI state it usually is not, because the state you are showing is one","type":"text"},{"text":" ","type":"text"},{"text":"update behind reality. If that matters, you want the newest element of the","type":"text"},{"text":" ","type":"text"},{"text":"window instead of the oldest, and that means buffering and waiting.","type":"text"}]},{"type":"thematicBreak"},{"text":"When to use swift-async-algorithms instead","anchor":"When-to-use-swift-async-algorithms-instead","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The package has "},{"type":"codeVoice","code":"throttle(for:clock:latest:)"},{"type":"text","text":", and it does not work the way"},{"type":"text","text":" "},{"text":"the operator above does. From ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"If values are produced by the base ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" the throttle does not"},{"type":"text","text":" "},{"type":"text","text":"resume its next iterator until the period has elapsed or unless a terminal"},{"type":"text","text":" "},{"type":"text","text":"event is encountered."}]}]},{"inlineContent":[{"type":"text","text":"So it waits out the window and then emits, and "},{"type":"codeVoice","code":"latest"},{"text":" decides whether you","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"get the newest or the oldest element of that window. Use it when you want the"},{"text":" ","type":"text"},{"text":"newest value, or a reduction over the window, or simply do not want to own","type":"text"},{"text":" ","type":"text"},{"text":"this code.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Write your own when you want the leading edge with no waiting and no","type":"text"},{"text":" ","type":"text"},{"text":"buffering, when you cannot add a dependency, or when you want to understand","type":"text"},{"text":" ","type":"text"},{"text":"what these operators actually do. The last reason is the one that got me","type":"text"},{"text":" ","type":"text"},{"text":"started.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Links","anchor":"Links","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"overridingTitle":"Throttling","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","overridingTitleInlineContent":[{"text":"Throttling","type":"text"}],"type":"reference"},{"text":", the example with tests","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"type":"text","text":"swift-async-algorithms"}],"isActive":true,"type":"reference","overridingTitle":"swift-async-algorithms","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","isActive":true,"type":"reference"},{"text":", the same semantics in another library","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"https://github.com/apple/swift-async-algorithms/blob/main/Sources/AsyncAlgorithms/AsyncAlgorithms.docc/Guides/Throttle.md":{"titleInlineContent":[{"type":"text","text":"its documentation"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","type":"link","title":"its documentation"},"https://github.com/apple/swift-async-algorithms":{"titleInlineContent":[{"text":"swift-async-algorithms","type":"text"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","type":"link","title":"swift-async-algorithms"},"https://rxjs.dev/api/operators/throttleTime":{"titleInlineContent":[{"text":"RxJS throttleTime","type":"text"}],"identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","url":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","type":"link","title":"RxJS throttleTime"},"doc://ReleaseNotes/documentation/ReleaseNotes":{"abstract":[{"text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —","type":"text"},{"text":" ","type":"text"},{"text":"from real-time messaging platforms to fintech, transit, and enterprise tooling.","type":"text"}],"identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","title":"Haydar Karkin","type":"topic","kind":"symbol","url":"\/documentation\/releasenotes","role":"collection"},"https://github.com/haydarKarkin/Throttling":{"title":"Throttling","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","titleInlineContent":[{"text":"Throttling","type":"text"}],"type":"link","url":"https:\/\/github.com\/haydarKarkin\/Throttling"}}}