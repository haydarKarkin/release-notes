{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/releasenotes\/asyncsequenceoperator"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"sampleCodeDownload":{"action":{"overridingTitle":"View Throttling on GitHub","type":"reference","isActive":true,"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling"},"kind":"sampleDownload"},"identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Patch Notes","anchor":"Patch-Notes","generated":true,"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard library gives "},{"code":"AsyncSequence","type":"codeVoice"},{"text":" the basics: ","type":"text"},{"type":"codeVoice","code":"map"},{"text":", ","type":"text"},{"type":"codeVoice","code":"filter"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"compactMap"},{"text":", ","type":"text"},{"type":"codeVoice","code":"prefix"},{"text":", ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":". Anything beyond that comes from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms"},{"text":" or from you.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sometimes writing it yourself is the better trade. The semantics you need may"},{"type":"text","text":" "},{"type":"text","text":"not be the ones the library offers, or you may not want another dependency in"},{"type":"text","text":" "},{"type":"text","text":"a shared module. Either way it is around thirty lines once you know the shape,"},{"type":"text","text":" "},{"type":"text","text":"and the shape is what this article is about."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The example is "},{"code":"throttleFirst","type":"codeVoice"},{"type":"text","text":": pass the first element of every time window"},{"type":"text","text":" "},{"type":"text","text":"through, drop everything that arrives before the window is over. Working code"},{"type":"text","text":" "},{"type":"text","text":"with tests is in the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling"},{"type":"text","text":" repository."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"The-throttling-logic","text":"The throttling logic","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"First the semantics, because “throttle” means different things in different"},{"type":"text","text":" "},{"type":"text","text":"libraries. Mine is the leading edge variant. With a window of 100ms and"},{"type":"text","text":" "},{"type":"text","text":"elements arriving at 0, 50, 110, 610 and 620ms:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Arrives at"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Result"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"50ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"dropped, window still open"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"110ms"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"passes, new window opens"}]}]],[[{"inlineContent":[{"type":"text","text":"610ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, new window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"620ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"dropped"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now "},{"code":"next()","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["public mutating func next() async throws -> Element? {","    while let element = try await base.next() {","        let now = clock.now","","        if let windowStart, windowStart.duration(to: now) < interval {","            continue","        }","","        windowStart = now","        return element","    }","","    return nil","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The loop is the whole idea. Dropping an element does not mean returning"},{"type":"text","text":" "},{"type":"text","text":"something, it means pulling the next one. A caller asking for one element can"},{"type":"text","text":" "},{"type":"text","text":"make us pull ten from the base sequence. When the base sequence ends we return"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and stop."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what is missing: no timer, no "},{"code":"Task","type":"codeVoice"},{"type":"text","text":", no buffer. The operator only ever"},{"type":"text","text":" "},{"type":"text","text":"looks at the clock when an element arrives. That keeps it cheap, and it is"},{"type":"text","text":" "},{"type":"text","text":"also why cancellation needs no code of its own. There is nothing to cancel"},{"type":"text","text":" "},{"type":"text","text":"except the "},{"code":"base.next()","type":"codeVoice"},{"type":"text","text":" we are suspended on, and that already handles it."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Inject-the-clock","text":"Inject the clock","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The obvious version of the code above reads "},{"code":"ContinuousClock.now","type":"codeVoice"},{"type":"text","text":" directly."},{"type":"text","text":" "},{"type":"text","text":"Do not do that. Make the operator generic over the clock instead:"}]},{"type":"codeListing","code":["public struct AsyncThrottleFirstSequence<Base: AsyncSequence, C: Clock>: AsyncSequence {","    public typealias Element = Base.Element","","    let base: Base","    let interval: C.Duration","    let clock: C","","    public struct Iterator: AsyncIteratorProtocol {","        var base: Base.AsyncIterator","        let interval: C.Duration","        let clock: C","        var windowStart: C.Instant?","","        \/\/ next() as above","    }","","    public func makeAsyncIterator() -> Iterator {","        Iterator(base: base.makeAsyncIterator(), interval: interval, clock: clock)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It costs one generic parameter and it is the difference between tests that"},{"type":"text","text":" "},{"type":"text","text":"sleep and tests that do not. More on that below."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two smaller decisions in the same area."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"code":"Clock","type":"codeVoice"},{"type":"text","text":", not "},{"code":"Date","type":"codeVoice"},{"type":"text","text":". Wall clock time can jump backwards, on an NTP"},{"type":"text","text":" "},{"type":"text","text":"correction or when the user changes the date. A window measured with "},{"code":"Date","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"breaks when it does. "},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":" only moves forward."}]},{"type":"paragraph","inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":" also keeps counting while the device is asleep, which is"},{"type":"text","text":" "},{"type":"text","text":"what you want for throttling: if the app was suspended for an hour, the window"},{"type":"text","text":" "},{"type":"text","text":"is over. If you want the opposite, "},{"code":"SuspendingClock","type":"codeVoice"},{"type":"text","text":" is the other option."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"The-entry-point","text":"The entry point","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nobody wants to write the generic type by hand, so add the operator to"},{"type":"text","text":" "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" and give it a default clock:"}]},{"type":"codeListing","code":["public extension AsyncSequence {","    func throttleFirst<C: Clock>(","        for interval: C.Duration,","        clock: C,","    ) -> AsyncThrottleFirstSequence<Self, C> {","        AsyncThrottleFirstSequence(base: self, interval: interval, clock: clock)","    }","","    func throttleFirst(","        for interval: Duration,","    ) -> AsyncThrottleFirstSequence<Self, ContinuousClock> {","        throttleFirst(for: interval, clock: ContinuousClock())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now it reads like any other operator:"}]},{"type":"codeListing","code":["for try await update in updates.throttleFirst(for: .milliseconds(500)) {","    render(update)","}"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","anchor":"Testing-without-waiting","text":"Testing without waiting","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A time based operator tested with real time gives you a slow suite and flaky"},{"type":"text","text":" "},{"type":"text","text":"results on a loaded CI machine. Since the clock is injectable, we can do"},{"type":"text","text":" "},{"type":"text","text":"better."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trick is that a clock does not have to define its own instant type. Reuse"},{"type":"text","text":" "},{"code":"ContinuousClock.Instant","type":"codeVoice"},{"type":"text","text":" and there is no "},{"code":"InstantProtocol","type":"codeVoice"},{"type":"text","text":" conformance to"},{"type":"text","text":" "},{"type":"text","text":"write:"}]},{"type":"codeListing","code":["final class ManualClock: Clock, @unchecked Sendable {","    typealias Instant = ContinuousClock.Instant","","    private let lock = NSLock()","    private var instant = ContinuousClock.now","","    var now: Instant { lock.withLock { instant } }","    var minimumResolution: Duration { .zero }","","    func advance(by duration: Duration) {","        lock.withLock { instant = instant.advanced(by: duration) }","    }","","    func sleep(until deadline: Instant, tolerance: Duration?) async throws {}","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The empty "},{"type":"codeVoice","code":"sleep"},{"type":"text","text":" looks like cheating. It is safe here for one specific"},{"type":"text","text":" "},{"type":"text","text":"reason: our operator never sleeps, it only reads "},{"type":"codeVoice","code":"now"},{"type":"text","text":". An operator that does"},{"type":"text","text":" "},{"type":"text","text":"sleep, like "},{"type":"codeVoice","code":"debounce"},{"type":"text","text":", needs a clock that can actually park a task and wake"},{"type":"text","text":" "},{"type":"text","text":"it up, and that is a much bigger piece of test code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The second helper describes arrival times. It is a base sequence that moves"},{"type":"text","text":" "},{"type":"text","text":"the clock forward as it produces elements:"}]},{"type":"codeListing","code":["struct ScriptedSequence: AsyncSequence {","    let script: [(value: Int, after: Duration)]","    let clock: ManualClock","","    struct Iterator: AsyncIteratorProtocol {","        ...","        mutating func next() async -> Int? {","            guard index < script.count else { return nil }","","            let step = script[index]","            index += 1","            clock.advance(by: step.after)","            return step.value","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With those two, the test reads like the table from earlier:"}]},{"type":"codeListing","code":["@Test(\"drops elements that arrive inside the window\")","func dropsElementsInsideWindow() async throws {","    let clock = ManualClock()","    let base = ScriptedSequence(","        script: [","            (1, .zero),              \/\/ t = 0,   first element, passes","            (2, .milliseconds(50)),  \/\/ t = 50,  window still open, dropped","            (3, .milliseconds(60)),  \/\/ t = 110, window over, passes","            (4, .milliseconds(500)), \/\/ t = 610, window over, passes","            (5, .milliseconds(10)),  \/\/ t = 620, window still open, dropped","        ],","        clock: clock,","    )","","    let result = try await collect(base.throttleFirst(for: .milliseconds(100), clock: clock))","","    #expect(result == [1, 3, 4])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No sleeps, no tolerances, and the expected output is obvious from the input."},{"type":"text","text":" "},{"type":"text","text":"The suite in the repository also covers the boundary case, an empty base"},{"type":"text","text":" "},{"type":"text","text":"sequence, and that errors from the base sequence are not swallowed. It runs in"},{"type":"text","text":" "},{"type":"text","text":"about a millisecond."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is one test left on the real "},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", to exercise the default"},{"type":"text","text":" "},{"type":"text","text":"overload. It is written so that its assertion cannot depend on how fast the"},{"type":"text","text":" "},{"type":"text","text":"machine is: every element is buffered before iteration starts, so a one second"},{"type":"text","text":" "},{"type":"text","text":"window can only let the first one through. My first version of that test"},{"type":"text","text":" "},{"type":"text","text":"produced values 20ms apart and asserted that some of them got dropped. It"},{"type":"text","text":" "},{"type":"text","text":"failed the same day, on a loaded machine where each 20ms sleep took longer"},{"type":"text","text":" "},{"type":"text","text":"than the window. Even the smoke test should not measure time."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Two-things-that-bite","text":"Two things that bite","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Filter before you throttle."}],"type":"strong"},{"text":" If the stream starts with a value you do not","type":"text"},{"text":" ","type":"text"},{"text":"care about, an empty snapshot from a realtime database for example, that value","type":"text"},{"text":" ","type":"text"},{"text":"opens the window and the first real value gets dropped. The fix is not in the","type":"text"},{"text":" ","type":"text"},{"text":"operator. Filter the noise out first, so the window starts on data that","type":"text"},{"text":" ","type":"text"},{"text":"matters:","type":"text"}]},{"type":"codeListing","code":["updates","    .filter { !$0.isEmpty }","    .throttleFirst(for: .milliseconds(500))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"I lost time to this one, and it is not visible in any marble diagram.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The leading edge loses the last value."}],"type":"strong"},{"text":" If an element is dropped and then","type":"text"},{"text":" ","type":"text"},{"text":"the stream goes quiet, you never see it. For a progress counter that is fine.","type":"text"},{"text":" ","type":"text"},{"text":"For UI state it usually is not, because the state you are showing is one","type":"text"},{"text":" ","type":"text"},{"text":"update behind reality. If that matters, you want the newest element of the","type":"text"},{"text":" ","type":"text"},{"text":"window instead of the oldest, and that means buffering and waiting.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","anchor":"When-to-use-swift-async-algorithms-instead","text":"When to use swift-async-algorithms instead","level":2},{"type":"paragraph","inlineContent":[{"text":"The package has ","type":"text"},{"code":"throttle(for:clock:latest:)","type":"codeVoice"},{"text":", and it does not work the way","type":"text"},{"text":" ","type":"text"},{"text":"the operator above does. From ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","type":"reference","isActive":true},{"text":":","type":"text"}]},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"If values are produced by the base "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" the throttle does not"},{"type":"text","text":" "},{"type":"text","text":"resume its next iterator until the period has elapsed or unless a terminal"},{"type":"text","text":" "},{"type":"text","text":"event is encountered."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"So it waits out the window and then emits, and ","type":"text"},{"code":"latest","type":"codeVoice"},{"text":" decides whether you","type":"text"},{"text":" ","type":"text"},{"text":"get the newest or the oldest element of that window. Use it when you want the","type":"text"},{"text":" ","type":"text"},{"text":"newest value, or a reduction over the window, or simply do not want to own","type":"text"},{"text":" ","type":"text"},{"text":"this code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Write your own when you want the leading edge with no waiting and no","type":"text"},{"text":" ","type":"text"},{"text":"buffering, when you cannot add a dependency, or when you want to understand","type":"text"},{"text":" ","type":"text"},{"text":"what these operators actually do. The last reason is the one that got me","type":"text"},{"text":" ","type":"text"},{"text":"started.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","anchor":"Links","text":"Links","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","overridingTitle":"Throttling","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Throttling","type":"text"}]},{"type":"text","text":", the example with tests"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","overridingTitle":"swift-async-algorithms","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"swift-async-algorithms","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","type":"reference","isActive":true},{"type":"text","text":", the same semantics in another library"}]}]}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Haydar Karkin"}],"title":"Writing Your Own AsyncSequence Operator","images":[{"type":"card","identifier":"card-async.svg"}]},"abstract":[{"type":"text","text":"What it takes to add an operator like "},{"code":"throttleFirst","type":"codeVoice"},{"type":"text","text":" to "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"how to test it without waiting for real time to pass."}],"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"type":"topic","title":"Haydar Karkin","role":"collection","kind":"symbol","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","abstract":[{"type":"text","text":"Senior iOS Developer. I build iOS apps that keep working as they grow."}],"url":"\/documentation\/releasenotes"},"https://github.com/apple/swift-async-algorithms":{"title":"swift-async-algorithms","titleInlineContent":[{"type":"text","text":"swift-async-algorithms"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms","type":"link","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms"},"card-docc.svg":{"alt":"A document page","variants":[{"svgID":"bg","url":"\/images\/ReleaseNotes\/card-docc.svg","traits":["1x","light"]},{"svgID":"bg","url":"\/images\/ReleaseNotes\/card-docc~dark.svg","traits":["1x","dark"]}],"type":"image","identifier":"card-docc.svg"},"doc://ReleaseNotes/documentation/ReleaseNotes/DoccPipeline":{"type":"topic","title":"Combining Generated and Manual Docs","role":"article","images":[{"type":"card","identifier":"card-docc.svg"}],"kind":"article","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","abstract":[{"type":"text","text":"Building one documentation site from two sources: the API reference the"},{"type":"text","text":" "},{"type":"text","text":"compiler generates, and the articles I write by hand."}],"url":"\/documentation\/releasenotes\/doccpipeline"},"https://rxjs.dev/api/operators/throttleTime":{"title":"RxJS throttleTime","titleInlineContent":[{"type":"text","text":"RxJS throttleTime"}],"url":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","type":"link","identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime"},"https://github.com/haydarKarkin/Throttling":{"url":"https:\/\/github.com\/haydarKarkin\/Throttling","checksum":null,"type":"download","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling"},"card-async.svg":{"alt":null,"variants":[{"svgID":"bg","url":"\/images\/ReleaseNotes\/card-async.svg","traits":["1x","light"]},{"svgID":"bg","url":"\/images\/ReleaseNotes\/card-async~dark.svg","traits":["1x","dark"]}],"type":"image","identifier":"card-async.svg"},"https://github.com/apple/swift-async-algorithms/blob/main/Sources/AsyncAlgorithms/AsyncAlgorithms.docc/Guides/Throttle.md":{"title":"its documentation","titleInlineContent":[{"type":"text","text":"its documentation"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","type":"link","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md"}}}