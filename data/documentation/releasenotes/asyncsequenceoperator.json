{"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Haydar Karkin"}],"title":"Writing Your Own AsyncSequence Operator"},"hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"variants":[{"paths":["\/documentation\/releasenotes\/asyncsequenceoperator"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The standard library gives ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" the basics: ","type":"text"},{"type":"codeVoice","code":"map"},{"text":", ","type":"text"},{"code":"filter","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"compactMap"},{"text":", ","type":"text"},{"code":"prefix","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"reduce"},{"text":". Anything beyond that comes from","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","isActive":true},{"text":" or from you.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sometimes writing it yourself is the better trade. The semantics you need may","type":"text"},{"text":" ","type":"text"},{"text":"not be the ones the library offers, or you may not want another dependency in","type":"text"},{"text":" ","type":"text"},{"text":"a shared module. Either way it is around thirty lines once you know the shape,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and the shape is what this article is about."}],"type":"paragraph"},{"inlineContent":[{"text":"The example is ","type":"text"},{"type":"codeVoice","code":"throttleFirst"},{"text":": pass the first element of every time window","type":"text"},{"text":" ","type":"text"},{"text":"through, drop everything that arrives before the window is over. Working code","type":"text"},{"text":" ","type":"text"},{"text":"with tests is in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling"},{"text":" repository.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"The-throttling-logic","text":"The throttling logic"},{"inlineContent":[{"text":"First the semantics, because “throttle” means different things in different","type":"text"},{"type":"text","text":" "},{"text":"libraries. Mine is the leading edge variant. With a window of 100ms and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"elements arriving at 0, 50, 110, 610 and 620ms:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Arrives at"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Result","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"passes, window opens","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"50ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"dropped, window still open","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"110ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"passes, new window opens","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"610ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"passes, new window opens","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"620ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"dropped","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Now ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["public mutating func next() async throws -> Element? {","    while let element = try await base.next() {","        let now = clock.now","","        if let windowStart, windowStart.duration(to: now) < interval {","            continue","        }","","        windowStart = now","        return element","    }","","    return nil","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The loop is the whole idea. Dropping an element does not mean returning","type":"text"},{"text":" ","type":"text"},{"text":"something, it means pulling the next one. A caller asking for one element can","type":"text"},{"text":" ","type":"text"},{"text":"make us pull ten from the base sequence. When the base sequence ends we return","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and stop.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note what is missing: no timer, no ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":", no buffer. The operator only ever","type":"text"},{"text":" ","type":"text"},{"text":"looks at the clock when an element arrives. That keeps it cheap, and it is","type":"text"},{"text":" ","type":"text"},{"text":"also why cancellation needs no code of its own. There is nothing to cancel","type":"text"},{"text":" ","type":"text"},{"text":"except the ","type":"text"},{"type":"codeVoice","code":"base.next()"},{"text":" we are suspended on, and that already handles it.","type":"text"}]},{"type":"thematicBreak"},{"text":"Inject the clock","type":"heading","level":2,"anchor":"Inject-the-clock"},{"type":"paragraph","inlineContent":[{"text":"The obvious version of the code above reads ","type":"text"},{"type":"codeVoice","code":"ContinuousClock.now"},{"text":" directly.","type":"text"},{"text":" ","type":"text"},{"text":"Do not do that. Make the operator generic over the clock instead:","type":"text"}]},{"type":"codeListing","code":["public struct AsyncThrottleFirstSequence<Base: AsyncSequence, C: Clock>: AsyncSequence {","    public typealias Element = Base.Element","","    let base: Base","    let interval: C.Duration","    let clock: C","","    public struct Iterator: AsyncIteratorProtocol {","        var base: Base.AsyncIterator","        let interval: C.Duration","        let clock: C","        var windowStart: C.Instant?","","        \/\/ next() as above","    }","","    public func makeAsyncIterator() -> Iterator {","        Iterator(base: base.makeAsyncIterator(), interval: interval, clock: clock)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It costs one generic parameter and it is the difference between tests that"},{"type":"text","text":" "},{"type":"text","text":"sleep and tests that do not. More on that below."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two smaller decisions in the same area."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Clock"},{"type":"text","text":", not "},{"type":"codeVoice","code":"Date"},{"type":"text","text":". Wall clock time can jump backwards, on an NTP"},{"type":"text","text":" "},{"type":"text","text":"correction or when the user changes the date. A window measured with "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" "},{"type":"text","text":"breaks when it does. "},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" only moves forward."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" also keeps counting while the device is asleep, which is"},{"type":"text","text":" "},{"type":"text","text":"what you want for throttling: if the app was suspended for an hour, the window"},{"type":"text","text":" "},{"type":"text","text":"is over. If you want the opposite, "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":" is the other option."}]},{"type":"thematicBreak"},{"text":"The entry point","type":"heading","level":2,"anchor":"The-entry-point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nobody wants to write the generic type by hand, so add the operator to"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" and give it a default clock:"}]},{"type":"codeListing","code":["public extension AsyncSequence {","    func throttleFirst<C: Clock>(","        for interval: C.Duration,","        clock: C,","    ) -> AsyncThrottleFirstSequence<Self, C> {","        AsyncThrottleFirstSequence(base: self, interval: interval, clock: clock)","    }","","    func throttleFirst(","        for interval: Duration,","    ) -> AsyncThrottleFirstSequence<Self, ContinuousClock> {","        throttleFirst(for: interval, clock: ContinuousClock())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now it reads like any other operator:"}]},{"type":"codeListing","code":["for try await update in updates.throttleFirst(for: .milliseconds(500)) {","    render(update)","}"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"Testing without waiting","type":"heading","level":2,"anchor":"Testing-without-waiting"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A time based operator tested with real time gives you a slow suite and flaky"},{"type":"text","text":" "},{"type":"text","text":"results on a loaded CI machine. Since the clock is injectable, we can do"},{"type":"text","text":" "},{"type":"text","text":"better."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trick is that a clock does not have to define its own instant type. Reuse"},{"type":"text","text":" "},{"type":"codeVoice","code":"ContinuousClock.Instant"},{"type":"text","text":" and there is no "},{"type":"codeVoice","code":"InstantProtocol"},{"type":"text","text":" conformance to"},{"type":"text","text":" "},{"type":"text","text":"write:"}]},{"type":"codeListing","code":["final class ManualClock: Clock, @unchecked Sendable {","    typealias Instant = ContinuousClock.Instant","","    private let lock = NSLock()","    private var instant = ContinuousClock.now","","    var now: Instant { lock.withLock { instant } }","    var minimumResolution: Duration { .zero }","","    func advance(by duration: Duration) {","        lock.withLock { instant = instant.advanced(by: duration) }","    }","","    func sleep(until deadline: Instant, tolerance: Duration?) async throws {}","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The empty "},{"type":"codeVoice","code":"sleep"},{"type":"text","text":" looks like cheating. It is safe here for one specific"},{"type":"text","text":" "},{"type":"text","text":"reason: our operator never sleeps, it only reads "},{"type":"codeVoice","code":"now"},{"text":". An operator that does","type":"text"},{"text":" ","type":"text"},{"text":"sleep, like ","type":"text"},{"type":"codeVoice","code":"debounce"},{"text":", needs a clock that can actually park a task and wake","type":"text"},{"text":" ","type":"text"},{"text":"it up, and that is a much bigger piece of test code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The second helper describes arrival times. It is a base sequence that moves","type":"text"},{"text":" ","type":"text"},{"text":"the clock forward as it produces elements:","type":"text"}]},{"type":"codeListing","code":["struct ScriptedSequence: AsyncSequence {","    let script: [(value: Int, after: Duration)]","    let clock: ManualClock","","    struct Iterator: AsyncIteratorProtocol {","        ...","        mutating func next() async -> Int? {","            guard index < script.count else { return nil }","","            let step = script[index]","            index += 1","            clock.advance(by: step.after)","            return step.value","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With those two, the test reads like the table from earlier:"}]},{"type":"codeListing","code":["@Test(\"drops elements that arrive inside the window\")","func dropsElementsInsideWindow() async throws {","    let clock = ManualClock()","    let base = ScriptedSequence(","        script: [","            (1, .zero),              \/\/ t = 0,   first element, passes","            (2, .milliseconds(50)),  \/\/ t = 50,  window still open, dropped","            (3, .milliseconds(60)),  \/\/ t = 110, window over, passes","            (4, .milliseconds(500)), \/\/ t = 610, window over, passes","            (5, .milliseconds(10)),  \/\/ t = 620, window still open, dropped","        ],","        clock: clock,","    )","","    let result = try await collect(base.throttleFirst(for: .milliseconds(100), clock: clock))","","    #expect(result == [1, 3, 4])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No sleeps, no tolerances, and the expected output is obvious from the input."},{"type":"text","text":" "},{"type":"text","text":"The suite in the repository also covers the boundary case, an empty base"},{"type":"text","text":" "},{"type":"text","text":"sequence, and that errors from the base sequence are not swallowed. It runs in"},{"type":"text","text":" "},{"type":"text","text":"a few milliseconds. I keep one test on the real "},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" as a smoke"},{"type":"text","text":" "},{"type":"text","text":"test, and that one is deliberately loose about what it asserts."}]},{"type":"thematicBreak"},{"text":"Two things that bite","type":"heading","level":2,"anchor":"Two-things-that-bite"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Filter before you throttle.","type":"text"}]},{"type":"text","text":" If the stream starts with a value you do not"},{"type":"text","text":" "},{"type":"text","text":"care about, an empty snapshot from a realtime database for example, that value"},{"type":"text","text":" "},{"type":"text","text":"opens the window and the first real value gets dropped. The fix is not in the"},{"type":"text","text":" "},{"type":"text","text":"operator. Filter the noise out first, so the window starts on data that"},{"type":"text","text":" "},{"type":"text","text":"matters:"}]},{"type":"codeListing","code":["updates","    .filter { !$0.isEmpty }","    .throttleFirst(for: .milliseconds(500))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"I lost time to this one, and it is not visible in any marble diagram."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"The leading edge loses the last value.","type":"text"}]},{"type":"text","text":" If an element is dropped and then"},{"type":"text","text":" "},{"type":"text","text":"the stream goes quiet, you never see it. For a progress counter that is fine."},{"type":"text","text":" "},{"type":"text","text":"For UI state it usually is not, because the state you are showing is one"},{"type":"text","text":" "},{"type":"text","text":"update behind reality. If that matters, you want the newest element of the"},{"type":"text","text":" "},{"type":"text","text":"window instead of the oldest, and that means buffering and waiting."}]},{"type":"thematicBreak"},{"text":"When to use swift-async-algorithms instead","type":"heading","level":2,"anchor":"When-to-use-swift-async-algorithms-instead"},{"type":"paragraph","inlineContent":[{"text":"The package has ","type":"text"},{"type":"codeVoice","code":"throttle(for:clock:latest:)"},{"text":", and it does not work the way","type":"text"},{"text":" ","type":"text"},{"text":"the operator above does. From ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"If values are produced by the base "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" the throttle does not"},{"type":"text","text":" "},{"type":"text","text":"resume its next iterator until the period has elapsed or unless a terminal"},{"type":"text","text":" "},{"type":"text","text":"event is encountered."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"So it waits out the window and then emits, and ","type":"text"},{"type":"codeVoice","code":"latest"},{"text":" decides whether you","type":"text"},{"text":" ","type":"text"},{"text":"get the newest or the oldest element of that window. Use it when you want the","type":"text"},{"text":" ","type":"text"},{"text":"newest value, or a reduction over the window, or simply do not want to own","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"this code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Write your own when you want the leading edge with no waiting and no"},{"type":"text","text":" "},{"type":"text","text":"buffering, when you cannot add a dependency, or when you want to understand"},{"type":"text","text":" "},{"type":"text","text":"what these operators actually do. The last reason is the one that got me"},{"type":"text","text":" "},{"type":"text","text":"started."}]},{"type":"thematicBreak"},{"text":"Links","type":"heading","level":2,"anchor":"Links"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"overridingTitleInlineContent":[{"type":"text","text":"Throttling"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","overridingTitle":"Throttling"},{"type":"text","text":", the example with tests"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"overridingTitleInlineContent":[{"text":"swift-async-algorithms","type":"text"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","overridingTitle":"swift-async-algorithms"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime"},{"type":"text","text":", the same semantics in another library"}],"type":"paragraph"}]}]}]}],"abstract":[{"text":"What it takes to add an operator like ","type":"text"},{"code":"throttleFirst","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"how to test it without waiting for real time to pass.","type":"text"}],"kind":"article","identifier":{"url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://ReleaseNotes/documentation/ReleaseNotes":{"url":"\/documentation\/releasenotes","title":"Haydar Karkin","abstract":[{"type":"text","text":"Senior iOS Developer with 12+ years of experience shipping apps that people actually use —"},{"type":"text","text":" "},{"type":"text","text":"from real-time messaging platforms to fintech, transit, and enterprise tooling."}],"type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"},"https://github.com/haydarKarkin/Throttling":{"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","type":"link","title":"Throttling","titleInlineContent":[{"text":"Throttling","type":"text"}],"url":"https:\/\/github.com\/haydarKarkin\/Throttling"},"https://rxjs.dev/api/operators/throttleTime":{"identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","type":"link","title":"RxJS throttleTime","titleInlineContent":[{"text":"RxJS throttleTime","type":"text"}],"url":"https:\/\/rxjs.dev\/api\/operators\/throttleTime"},"https://github.com/apple/swift-async-algorithms":{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","type":"link","title":"swift-async-algorithms","titleInlineContent":[{"text":"swift-async-algorithms","type":"text"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms"},"https://github.com/apple/swift-async-algorithms/blob/main/Sources/AsyncAlgorithms/AsyncAlgorithms.docc/Guides/Throttle.md":{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","type":"link","title":"its documentation","titleInlineContent":[{"text":"its documentation","type":"text"}],"url":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md"}}}