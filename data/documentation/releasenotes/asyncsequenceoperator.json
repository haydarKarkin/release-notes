{"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The standard library gives ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" the basics: ","type":"text"},{"code":"map","type":"codeVoice"},{"text":", ","type":"text"},{"code":"filter","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"compactMap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"prefix","type":"codeVoice"},{"text":", ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":". Anything beyond that comes from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","isActive":true,"type":"reference"},{"text":" or from you.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Sometimes writing it yourself is the better trade. The semantics you need may","type":"text"},{"text":" ","type":"text"},{"text":"not be the ones the library offers, or you may not want another dependency in","type":"text"},{"text":" ","type":"text"},{"text":"a shared module. Either way it is around thirty lines once you know the shape,","type":"text"},{"text":" ","type":"text"},{"text":"and the shape is what this article is about.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The example is ","type":"text"},{"code":"throttleFirst","type":"codeVoice"},{"text":": pass the first element of every time window","type":"text"},{"text":" ","type":"text"},{"text":"through, drop everything that arrives before the window is over. Working code","type":"text"},{"text":" ","type":"text"},{"text":"with tests is in the ","type":"text"},{"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","isActive":true,"type":"reference"},{"text":" repository.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"anchor":"The-throttling-logic","type":"heading","text":"The throttling logic"},{"type":"paragraph","inlineContent":[{"text":"First the semantics, because “throttle” means different things in different","type":"text"},{"text":" ","type":"text"},{"text":"libraries. Mine is the leading edge variant. With a window of 100ms and","type":"text"},{"text":" ","type":"text"},{"text":"elements arriving at 0, 50, 110, 610 and 620ms:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Arrives at"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Result"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"50ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"dropped, window still open"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"110ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, new window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"610ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"passes, new window opens"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"620ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"dropped"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"Now ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["public mutating func next() async throws -> Element? {","    while let element = try await base.next() {","        let now = clock.now","","        if let windowStart, windowStart.duration(to: now) < interval {","            continue","        }","","        windowStart = now","        return element","    }","","    return nil","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The loop is the whole idea. Dropping an element does not mean returning","type":"text"},{"text":" ","type":"text"},{"text":"something, it means pulling the next one. A caller asking for one element can","type":"text"},{"text":" ","type":"text"},{"text":"make us pull ten from the base sequence. When the base sequence ends we return","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and stop.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note what is missing: no timer, no ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":", no buffer. The operator only ever","type":"text"},{"text":" ","type":"text"},{"text":"looks at the clock when an element arrives. That keeps it cheap, and it is","type":"text"},{"text":" ","type":"text"},{"text":"also why cancellation needs no code of its own. There is nothing to cancel","type":"text"},{"text":" ","type":"text"},{"text":"except the ","type":"text"},{"code":"base.next()","type":"codeVoice"},{"text":" we are suspended on, and that already handles it.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"anchor":"Inject-the-clock","type":"heading","text":"Inject the clock"},{"type":"paragraph","inlineContent":[{"text":"The obvious version of the code above reads ","type":"text"},{"code":"ContinuousClock.now","type":"codeVoice"},{"text":" directly.","type":"text"},{"text":" ","type":"text"},{"text":"Do not do that. Make the operator generic over the clock instead:","type":"text"}]},{"type":"codeListing","code":["public struct AsyncThrottleFirstSequence<Base: AsyncSequence, C: Clock>: AsyncSequence {","    public typealias Element = Base.Element","","    let base: Base","    let interval: C.Duration","    let clock: C","","    public struct Iterator: AsyncIteratorProtocol {","        var base: Base.AsyncIterator","        let interval: C.Duration","        let clock: C","        var windowStart: C.Instant?","","        \/\/ next() as above","    }","","    public func makeAsyncIterator() -> Iterator {","        Iterator(base: base.makeAsyncIterator(), interval: interval, clock: clock)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"It costs one generic parameter and it is the difference between tests that","type":"text"},{"text":" ","type":"text"},{"text":"sleep and tests that do not. More on that below.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two smaller decisions in the same area.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":", not ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":". Wall clock time can jump backwards, on an NTP","type":"text"},{"text":" ","type":"text"},{"text":"correction or when the user changes the date. A window measured with ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" ","type":"text"},{"text":"breaks when it does. ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":" only moves forward.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"text":" also keeps counting while the device is asleep, which is","type":"text"},{"text":" ","type":"text"},{"text":"what you want for throttling: if the app was suspended for an hour, the window","type":"text"},{"text":" ","type":"text"},{"text":"is over. If you want the opposite, ","type":"text"},{"code":"SuspendingClock","type":"codeVoice"},{"text":" is the other option.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"anchor":"The-entry-point","type":"heading","text":"The entry point"},{"type":"paragraph","inlineContent":[{"text":"Nobody wants to write the generic type by hand, so add the operator to","type":"text"},{"text":" ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" and give it a default clock:","type":"text"}]},{"type":"codeListing","code":["public extension AsyncSequence {","    func throttleFirst<C: Clock>(","        for interval: C.Duration,","        clock: C,","    ) -> AsyncThrottleFirstSequence<Self, C> {","        AsyncThrottleFirstSequence(base: self, interval: interval, clock: clock)","    }","","    func throttleFirst(","        for interval: Duration,","    ) -> AsyncThrottleFirstSequence<Self, ContinuousClock> {","        throttleFirst(for: interval, clock: ContinuousClock())","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Now it reads like any other operator:","type":"text"}]},{"type":"codeListing","code":["for try await update in updates.throttleFirst(for: .milliseconds(500)) {","    render(update)","}"],"syntax":"swift"},{"type":"thematicBreak"},{"level":2,"anchor":"Testing-without-waiting","type":"heading","text":"Testing without waiting"},{"type":"paragraph","inlineContent":[{"text":"A time based operator tested with real time gives you a slow suite and flaky","type":"text"},{"text":" ","type":"text"},{"text":"results on a loaded CI machine. Since the clock is injectable, we can do","type":"text"},{"text":" ","type":"text"},{"text":"better.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The trick is that a clock does not have to define its own instant type. Reuse","type":"text"},{"text":" ","type":"text"},{"code":"ContinuousClock.Instant","type":"codeVoice"},{"text":" and there is no ","type":"text"},{"code":"InstantProtocol","type":"codeVoice"},{"text":" conformance to","type":"text"},{"text":" ","type":"text"},{"text":"write:","type":"text"}]},{"type":"codeListing","code":["final class ManualClock: Clock, @unchecked Sendable {","    typealias Instant = ContinuousClock.Instant","","    private let lock = NSLock()","    private var instant = ContinuousClock.now","","    var now: Instant { lock.withLock { instant } }","    var minimumResolution: Duration { .zero }","","    func advance(by duration: Duration) {","        lock.withLock { instant = instant.advanced(by: duration) }","    }","","    func sleep(until deadline: Instant, tolerance: Duration?) async throws {}","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The empty ","type":"text"},{"code":"sleep","type":"codeVoice"},{"text":" looks like cheating. It is safe here for one specific","type":"text"},{"text":" ","type":"text"},{"text":"reason: our operator never sleeps, it only reads ","type":"text"},{"code":"now","type":"codeVoice"},{"text":". An operator that does","type":"text"},{"text":" ","type":"text"},{"text":"sleep, like ","type":"text"},{"code":"debounce","type":"codeVoice"},{"text":", needs a clock that can actually park a task and wake","type":"text"},{"text":" ","type":"text"},{"text":"it up, and that is a much bigger piece of test code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The second helper describes arrival times. It is a base sequence that moves","type":"text"},{"text":" ","type":"text"},{"text":"the clock forward as it produces elements:","type":"text"}]},{"type":"codeListing","code":["struct ScriptedSequence: AsyncSequence {","    let script: [(value: Int, after: Duration)]","    let clock: ManualClock","","    struct Iterator: AsyncIteratorProtocol {","        ...","        mutating func next() async -> Int? {","            guard index < script.count else { return nil }","","            let step = script[index]","            index += 1","            clock.advance(by: step.after)","            return step.value","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"With those two, the test reads like the table from earlier:","type":"text"}]},{"type":"codeListing","code":["@Test(\"drops elements that arrive inside the window\")","func dropsElementsInsideWindow() async throws {","    let clock = ManualClock()","    let base = ScriptedSequence(","        script: [","            (1, .zero),              \/\/ t = 0,   first element, passes","            (2, .milliseconds(50)),  \/\/ t = 50,  window still open, dropped","            (3, .milliseconds(60)),  \/\/ t = 110, window over, passes","            (4, .milliseconds(500)), \/\/ t = 610, window over, passes","            (5, .milliseconds(10)),  \/\/ t = 620, window still open, dropped","        ],","        clock: clock,","    )","","    let result = try await collect(base.throttleFirst(for: .milliseconds(100), clock: clock))","","    #expect(result == [1, 3, 4])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"No sleeps, no tolerances, and the expected output is obvious from the input.","type":"text"},{"text":" ","type":"text"},{"text":"The suite in the repository also covers the boundary case, an empty base","type":"text"},{"text":" ","type":"text"},{"text":"sequence, and that errors from the base sequence are not swallowed. It runs in","type":"text"},{"text":" ","type":"text"},{"text":"about a millisecond.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There is one test left on the real ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":", to exercise the default","type":"text"},{"text":" ","type":"text"},{"text":"overload. It is written so that its assertion cannot depend on how fast the","type":"text"},{"text":" ","type":"text"},{"text":"machine is: every element is buffered before iteration starts, so a one second","type":"text"},{"text":" ","type":"text"},{"text":"window can only let the first one through. My first version of that test","type":"text"},{"text":" ","type":"text"},{"text":"produced values 20ms apart and asserted that some of them got dropped. It","type":"text"},{"text":" ","type":"text"},{"text":"failed the same day, on a loaded machine where each 20ms sleep took longer","type":"text"},{"text":" ","type":"text"},{"text":"than the window. Even the smoke test should not measure time.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"anchor":"Two-things-that-bite","type":"heading","text":"Two things that bite"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Filter before you throttle."}],"type":"strong"},{"text":" If the stream starts with a value you do not","type":"text"},{"text":" ","type":"text"},{"text":"care about, an empty snapshot from a realtime database for example, that value","type":"text"},{"text":" ","type":"text"},{"text":"opens the window and the first real value gets dropped. The fix is not in the","type":"text"},{"text":" ","type":"text"},{"text":"operator. Filter the noise out first, so the window starts on data that","type":"text"},{"text":" ","type":"text"},{"text":"matters:","type":"text"}]},{"type":"codeListing","code":["updates","    .filter { !$0.isEmpty }","    .throttleFirst(for: .milliseconds(500))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"I lost time to this one, and it is not visible in any marble diagram.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The leading edge loses the last value."}],"type":"strong"},{"text":" If an element is dropped and then","type":"text"},{"text":" ","type":"text"},{"text":"the stream goes quiet, you never see it. For a progress counter that is fine.","type":"text"},{"text":" ","type":"text"},{"text":"For UI state it usually is not, because the state you are showing is one","type":"text"},{"text":" ","type":"text"},{"text":"update behind reality. If that matters, you want the newest element of the","type":"text"},{"text":" ","type":"text"},{"text":"window instead of the oldest, and that means buffering and waiting.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"anchor":"When-to-use-swift-async-algorithms-instead","type":"heading","text":"When to use swift-async-algorithms instead"},{"type":"paragraph","inlineContent":[{"text":"The package has ","type":"text"},{"code":"throttle(for:clock:latest:)","type":"codeVoice"},{"text":", and it does not work the way","type":"text"},{"text":" ","type":"text"},{"text":"the operator above does. From ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"If values are produced by the base "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" the throttle does not"},{"type":"text","text":" "},{"type":"text","text":"resume its next iterator until the period has elapsed or unless a terminal"},{"type":"text","text":" "},{"type":"text","text":"event is encountered."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"So it waits out the window and then emits, and ","type":"text"},{"code":"latest","type":"codeVoice"},{"text":" decides whether you","type":"text"},{"text":" ","type":"text"},{"text":"get the newest or the oldest element of that window. Use it when you want the","type":"text"},{"text":" ","type":"text"},{"text":"newest value, or a reduction over the window, or simply do not want to own","type":"text"},{"text":" ","type":"text"},{"text":"this code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Write your own when you want the leading edge with no waiting and no","type":"text"},{"text":" ","type":"text"},{"text":"buffering, when you cannot add a dependency, or when you want to understand","type":"text"},{"text":" ","type":"text"},{"text":"what these operators actually do. The last reason is the one that got me","type":"text"},{"text":" ","type":"text"},{"text":"started.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"anchor":"Links","type":"heading","text":"Links"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","overridingTitle":"Throttling","overridingTitleInlineContent":[{"type":"text","text":"Throttling"}],"isActive":true,"type":"reference"},{"text":", the example with tests","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","overridingTitle":"swift-async-algorithms","overridingTitleInlineContent":[{"type":"text","text":"swift-async-algorithms"}],"isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","isActive":true,"type":"reference"},{"text":", the same semantics in another library","type":"text"}]}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/releasenotes\/asyncsequenceoperator"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/AsyncSequenceOperator"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"What it takes to add an operator like "},{"type":"codeVoice","code":"throttleFirst"},{"type":"text","text":" to "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"how to test it without waiting for real time to pass."}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","overridingTitle":"View Throttling on GitHub","type":"reference","isActive":true}},"seeAlsoSections":[{"identifiers":["doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPersonalSite"],"anchor":"Patch-Notes","title":"Patch Notes","generated":true}],"metadata":{"roleHeading":"Article","images":[{"identifier":"card-async.svg","type":"card"}],"role":"article","modules":[{"name":"Haydar Karkin"}],"title":"Writing Your Own AsyncSequence Operator"},"references":{"doc://ReleaseNotes/documentation/ReleaseNotes/DoccPipeline":{"role":"article","title":"Combining Generated and Manual Docs","images":[{"identifier":"card-docc.svg","type":"card"}],"identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPipeline","url":"\/documentation\/releasenotes\/doccpipeline","kind":"article","abstract":[{"type":"text","text":"Building one documentation site from two sources: the API reference the"},{"type":"text","text":" "},{"type":"text","text":"compiler generates, and the articles I write by hand."}],"type":"topic"},"https://rxjs.dev/api/operators/throttleTime":{"titleInlineContent":[{"type":"text","text":"RxJS throttleTime"}],"type":"link","identifier":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","url":"https:\/\/rxjs.dev\/api\/operators\/throttleTime","title":"RxJS throttleTime"},"doc://ReleaseNotes/documentation/ReleaseNotes/DoccPersonalSite":{"kind":"article","url":"\/documentation\/releasenotes\/doccpersonalsite","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes\/DoccPersonalSite","type":"topic","abstract":[{"type":"text","text":"What a personal site actually needs, and how far DocC gets you with each of"},{"type":"text","text":" "},{"type":"text","text":"those things."}],"title":"Turning DocC into a Personal Site","images":[{"identifier":"card-site.svg","type":"card"}],"role":"article"},"https://github.com/haydarKarkin/Throttling":{"type":"download","identifier":"https:\/\/github.com\/haydarKarkin\/Throttling","checksum":null,"url":"https:\/\/github.com\/haydarKarkin\/Throttling"},"https://github.com/apple/swift-async-algorithms/blob/main/Sources/AsyncAlgorithms/AsyncAlgorithms.docc/Guides/Throttle.md":{"titleInlineContent":[{"type":"text","text":"its documentation"}],"type":"link","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","url":"https:\/\/github.com\/apple\/swift-async-algorithms\/blob\/main\/Sources\/AsyncAlgorithms\/AsyncAlgorithms.docc\/Guides\/Throttle.md","title":"its documentation"},"doc://ReleaseNotes/documentation/ReleaseNotes":{"kind":"symbol","url":"\/documentation\/releasenotes","identifier":"doc:\/\/ReleaseNotes\/documentation\/ReleaseNotes","type":"topic","abstract":[{"type":"text","text":"Senior iOS Developer. I build iOS apps that keep working as they grow."}],"title":"Haydar Karkin","role":"collection"},"card-site.svg":{"type":"image","identifier":"card-site.svg","alt":"A browser window with a header bar and two cards","variants":[{"svgID":"bg","traits":["1x","light"],"url":"\/images\/ReleaseNotes\/card-site.svg"},{"svgID":"bg","traits":["1x","dark"],"url":"\/images\/ReleaseNotes\/card-site~dark.svg"}]},"card-docc.svg":{"type":"image","identifier":"card-docc.svg","alt":"A document page","variants":[{"svgID":"bg","traits":["1x","light"],"url":"\/images\/ReleaseNotes\/card-docc.svg"},{"svgID":"bg","traits":["1x","dark"],"url":"\/images\/ReleaseNotes\/card-docc~dark.svg"}]},"card-async.svg":{"type":"image","identifier":"card-async.svg","alt":null,"variants":[{"svgID":"bg","traits":["1x","light"],"url":"\/images\/ReleaseNotes\/card-async.svg"},{"svgID":"bg","traits":["1x","dark"],"url":"\/images\/ReleaseNotes\/card-async~dark.svg"}]},"https://github.com/apple/swift-async-algorithms":{"titleInlineContent":[{"type":"text","text":"swift-async-algorithms"}],"type":"link","identifier":"https:\/\/github.com\/apple\/swift-async-algorithms","url":"https:\/\/github.com\/apple\/swift-async-algorithms","title":"swift-async-algorithms"}}}